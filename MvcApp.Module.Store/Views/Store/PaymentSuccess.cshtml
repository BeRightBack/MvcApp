@model MvcApp.Core.Order
@{
    ViewData["Title"] = "Payment Result";
    var paid = ViewBag.PaymentStatus == "paid";
    var failed = ViewBag.PaymentStatus == "failed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">
                    @if (paid)
                    {
                        <i class="fa fa-check-circle text-success" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">Payment Successful</h2>
                        <p class="text-muted">Thank you for your purchase! Your order is now being processed.</p>
                    }
                    else if (failed)
                    {
                        <i class="fa fa-times-circle text-danger" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">Payment Failed</h2>
                        <p class="text-muted">We could not confirm your payment. Please contact support if funds were taken.</p>
                    }
                    else
                    {
                        <i class="fa fa-clock-o text-warning" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">Payment Pending</h2>
                        <p class="text-muted">Your payment is still being processed. Please check your PayPal account for details.</p>
                    }
                    <hr />
                    <dl class="row text-start mb-4">
                        <dt class="col-6">Order #</dt>
                        <dd class="col-6">@Model.Id</dd>
                        <dt class="col-6">Total</dt>
                        <dd class="col-6">$@Model.TotalAmount.ToString("F2")</dd>
                        <dt class="col-6">Status</dt>
                        <dd class="col-6">@Model.Status</dd>
                        <dt class="col-6">Payment</dt>
                        <dd class="col-6">@Model.PaymentStatus</dd>
                    </dl>
                    <a asp-action="Orders" class="btn btn-primary">My Orders</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
