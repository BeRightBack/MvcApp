@model MvcApp.Core.Order
@{
    ViewData["Title"] = "Payment Result";
    var paid = ViewBag.PaymentStatus == "paid";
    var failed = ViewBag.PaymentStatus == "failed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">
                    @if (paid)
                    {
                        <i class="fa fa-check-circle text-success" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">@Localizer["Payment Successful"]</h2>
                        <p class="text-muted">@Localizer["Thank you for your purchase! Your order is now being processed."]</p>
                    }
                    else if (failed)
                    {
                        <i class="fa fa-times-circle text-danger" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">@Localizer["Payment Failed"]</h2>
                        <p class="text-muted">@Localizer["We could not confirm your payment. Please contact support if funds were taken."]</p>
                    }
                    else
                    {
                        <i class="fa fa-clock-o text-warning" style="font-size: 3.5rem;"></i>
                        <h2 class="mt-3">@Localizer["Payment Pending"]</h2>
                        <p class="text-muted">@Localizer["Your payment is still being processed. Please check your PayPal account for details."]</p>
                    }
                    <hr />
                    <dl class="row text-start mb-4">
                        <dt class="col-6">@Localizer["Order #"]</dt>
                        <dd class="col-6">@Model.Id</dd>
                        <dt class="col-6">@Localizer["Total"]</dt>
                        <dd class="col-6">$@Model.TotalAmount.ToString("F2")</dd>
                        <dt class="col-6">@Localizer["Status"]</dt>
                        <dd class="col-6">@Model.Status</dd>
                        <dt class="col-6">@Localizer["Payment"]</dt>
                        <dd class="col-6">@Model.PaymentStatus</dd>
                    </dl>
                    <a asp-action="Orders" class="btn btn-primary">@Localizer["My Orders"]</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Continue Shopping"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
