@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">
                    <i class="fa fa-ban text-warning" style="font-size: 3.5rem;"></i>
                    <h2 class="mt-3">Payment Cancelled</h2>
                    <p class="text-muted">Your payment was cancelled. If this was a mistake, please try again.</p>
                    <a asp-action="Checkout" class="btn btn-primary">Back to Checkout</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
