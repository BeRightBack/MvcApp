# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# IDE
.vs/
.vscode/
*.user
*.suo

# Test results
[Tt]est[Rr]esults/

# Local logs
*.log

# Serilog's rolling file sink writes logs/log-YYYYMMDD.txt, which the *.log rule above
# does not match - that is how 62 runtime log files came to be tracked. Ignore the
# directory instead of trying to match the rolling filename.
**/logs/

# Note: appsettings.json (secrets) is ignored per-project via MvcApp.Web/.gitignore;
# don't add a global appsettings.json rule here — the template sources ship one.

# But a ROOT-level appsettings.json is a real, credential-bearing file that appeared in the
# repo root and was NOT covered by any rule. `/appsettings.json` anchors to the root only,
# so the template trees (which legitimately ship appsettings.json) keep working.
/appsettings.json
/appsettings.Development.json
