<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Template profiles as data. Embedded so they are always present (including under test),
	       with an override path so a deployment can supply its own without a rebuild. -->
	  <EmbeddedResource Include="Templates/profiles.json" LogicalName="MvcApp.Services.Templates.profiles.json" />
	</ItemGroup>

 	<ItemGroup>
 		<PackageReference Include="MailKit" Version="4.17.0" />
 		<PackageReference Include="MimeKit" Version="4.17.0" />
 		<PackageReference Include="MySqlConnector" Version="2.5.0" />
 		<PackageReference Include="Serilog" Version="4.4.0" />
 	</ItemGroup>

 	<ItemGroup>
 	  <ProjectReference Include="..\MvcApp.Core\MvcApp.Core.csproj" />
  <ProjectReference Include="..\MvcApp.Localization\MvcApp.Localization.csproj" />
 	</ItemGroup>

</Project>
