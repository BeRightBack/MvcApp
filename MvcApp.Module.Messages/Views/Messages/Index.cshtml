@using MvcApp.Core.Models
@using MvcApp.Infrastructure.Extentions
@model MvcApp.Module.Messages.ViewModels.MessagesIndexViewModel
@{
    ViewData["Title"] = "Messages";
}

<div class="container mt-4">
    @if (TempData["MessagesError"] is string msgError && !string.IsNullOrWhiteSpace(msgError))
    {
        <div class="alert alert-warning">@msgError</div>
    }

    <div class="row">
        @if (Model.Suggestions.Any())
        {
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class='bx bxs-heart text-danger'></i> Suggested matches
                        </h4>
                        <a asp-controller="Matches" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View all</a>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var m in Model.Suggestions)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                                        <img src="@m.MainPhotoUrl" class="rounded-circle mx-auto mb-2" style="width:80px;height:80px;object-fit:cover;"
                                             onerror="this.onerror=null;this.src='/images/default-user.png';" alt="@m.KnownAs">
                                        <h6 class="mb-0">@m.KnownAs, @m.Age</h6>
                                        <small class="text-muted">
                                            @if (m.LastActive.IsOnline())
                                            {
                                                <span class="online-text">Online now</span>
                                            }
                                            else
                                            {
                                                <text>Active @m.LastActive.TimeAgo()</text>
                                            }
                                        </small>
                                        <a class="btn btn-sm rounded-pill btn-outline-primary mt-2" href="/Messages/Chat/@m.Id">
                                            <i class='bx bx-message-rounded-dots'></i> Say hi
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Conversations</h4>
                </div>
                <div class="card-body p-0">
                    @if (Model.Conversations.Any())
                    {
                        <div class="list-group list-group-flush" id="conversationList">
                            @foreach (var c in Model.Conversations)
                            {
                                <a asp-action="Chat" asp-route-id="@c.MemberId" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3">
                                    <div class="position-relative">
                                        <img src="@c.MainPhotoUrl"
                                             onerror="this.onerror=null;this.src='/images/default-user.png';"
                                             alt="" width="44" height="44"
                                             class="rounded-circle border" style="object-fit:cover">
                                        @if (c.LastActive.IsOnline())
                                        {
                                            <span class="online-dot" style="width:12px;height:12px;border:2px solid #fff;"></span>
                                        }
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong>@(string.IsNullOrEmpty(c.KnownAs) ? c.Username : c.KnownAs), @c.Age</strong>
                                            <small class="text-muted">@c.LastMessageAt.TimeAgo()</small>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted text-truncate" style="max-width:70%;">@c.LastMessage</small>
                                            @if (c.UnreadCount > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger">@c.UnreadCount new</span>
                                            }
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else if (!Model.Suggestions.Any())
                    {
                        <div class="text-center py-5">
                            <i class='bx bx-chat' style="font-size:3rem; color:#e74c6f;"></i>
                            <h5 class="mt-3">No conversations yet</h5>
                            <p class="text-muted">Match with someone to start chatting.</p>
                            <a asp-controller="Discover" asp-action="Index" class="btn btn-primary rounded-pill">
                                <i class='bx bx-compass'></i> Browse Discover
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">Send a message to one of your suggested matches above.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
