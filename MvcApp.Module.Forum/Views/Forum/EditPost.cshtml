@{
    var post = ViewBag.Post as ForumPost;
    ViewData["Title"] = "Edit Post";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Forums</a></li>
            <li class="breadcrumb-item"><a asp-action="Thread" asp-route-id="@post?.ThreadId">Thread</a></li>
            <li class="breadcrumb-item active">Edit Post</li>
        </ol>
    </nav>

    <h1><i class="fa fa-pencil"></i> Edit Post</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All"></div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="EditPost" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@post?.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Content</label>
                    @{ ViewData["RteName"] = "content"; ViewData["RteHeight"] = 400; ViewData["RteValue"] = post?.Content ?? ""; }
                    <partial name="_RichTextEditor" />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Save Changes
                </button>
                <a asp-action="Thread" asp-route-id="@post?.ThreadId" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
