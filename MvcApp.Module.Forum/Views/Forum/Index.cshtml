@model IEnumerable<ForumCategory>
@{
    ViewData["Title"] = "Forums";
    var forums = ViewBag.Forums as IEnumerable<Forum> ?? [];
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fa fa-comments"></i> Forums</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @foreach (var category in Model)
    {
        <div class="card mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@category.Name</h5>
                <span class="badge bg-light text-dark">@category.Description</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50%">Forum</th>
                            <th class="text-center">Threads</th>
                            <th class="text-center">Posts</th>
                            <th style="width:25%">Last Post</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var forum in forums.Where(f => f.CategoryId == category.Id))
                        {
                            <tr>
                                <td>
                                    <a asp-action="Forum" asp-route-id="@forum.Id" class="fw-bold text-decoration-none">
                                        <i class="fa fa-folder-o"></i> @forum.Name
                                    </a>
                                    @if (!string.IsNullOrEmpty(forum.Description))
                                    {
                                        <br /><small class="text-muted">@forum.Description</small>
                                    }
                                </td>
                                <td class="text-center">@forum.ThreadCount</td>
                                <td class="text-center">@forum.PostCount</td>
                                <td>
                                    @if (forum.LastPostAt.HasValue)
                                    {
                                        <small>
                                            by <strong>@forum.LastPostByUsername</strong><br />
                                            <span class="text-muted">@forum.LastPostAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">No posts</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
