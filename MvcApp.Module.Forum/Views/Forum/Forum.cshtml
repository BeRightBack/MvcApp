@model IEnumerable<ForumThread>
@{
    var forum = ViewBag.Forum as Forum;
    ViewData["Title"] = forum?.Name ?? "Forum";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Forums</a></li>
            <li class="breadcrumb-item active">@forum?.Name</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0"><i class="fa fa-folder-open-o"></i> @forum?.Name</h1>
        <a asp-action="CreateThread" asp-route-forumId="@forum?.Id" class="btn btn-primary">
            <i class="fa fa-plus"></i> New Thread
        </a>
    </div>

    @if (!string.IsNullOrEmpty(forum?.Description))
    {
        <p class="text-muted">@forum.Description</p>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:50%">Thread</th>
                        <th class="text-center">Replies</th>
                        <th class="text-center">Views</th>
                        <th style="width:25%">Last Post</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No threads yet. Start a new discussion!</td></tr>
                    }
                    @foreach (var thread in Model)
                    {
                        <tr class="@(thread.IsPinned ? "table-info" : "")">
                            <td>
                                <a asp-action="Thread" asp-route-id="@thread.Id" class="fw-bold text-decoration-none">
                                    @if (thread.IsPinned)
                                    {
                                        <i class="fa fa-thumb-tack text-danger"></i>
                                    }
                                    @if (thread.IsLocked)
                                    {
                                        <i class="fa fa-lock text-warning"></i>
                                    }
                                    <i class="fa fa-comment-o"></i> @thread.Title
                                </a>
                                <br /><small class="text-muted">by @thread.CreatedByUsername on @thread.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="text-center">@thread.ReplyCount</td>
                            <td class="text-center">@thread.ViewCount</td>
                            <td>
                                @if (thread.LastPostAt.HasValue)
                                {
                                    <small>
                                        by <strong>@thread.LastPostByUsername</strong><br />
                                        <span class="text-muted">@thread.LastPostAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">-</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        var page = (int)ViewBag.Page;
        var totalPages = (int)ViewBag.TotalPages;
    }
    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Forum" asp-route-id="@forum?.Id" asp-route-page="@(page - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Forum" asp-route-id="@forum?.Id" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Forum" asp-route-id="@forum?.Id" asp-route-page="@(page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
