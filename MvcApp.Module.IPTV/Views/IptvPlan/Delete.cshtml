@model MvcApp.Module.IPTV.Models.SubscriptionViewModels.SubscriptionPlanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = @Localizer["Delete Plan - Admin"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="IptvPlan" asp-action="Index">@Localizer["Plans"]</a></li>
        <li class="breadcrumb-item active">@Localizer["Delete"]</li>
    </ol>
</nav>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">@Localizer["Delete Plan"]</h5>
    </div>
    <div class="card-body">
        <h5>@Localizer["Are you sure you want to delete this plan?"]</h5>
        <h4>@Model.Name</h4>
        <p>@Model.Description</p>
        <ul>
            @foreach (var detail in Model.SubscriptionDetails)
            {
                <li>@detail.Description - @detail.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))</li>
            }
        </ul>
    </div>
    <div class="card-footer">
        <form asp-controller="IptvPlan" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
        </form>
        <a asp-controller="IptvPlan" asp-action="Index" class="btn btn-secondary">@Localizer["Back to List"]</a>
    </div>
</div>
