@model IEnumerable<BlogPost>
@{
    var year = ViewBag.ArchiveYear as int?;
    var month = ViewBag.ArchiveMonth as int?;
    var archiveMonths = ViewBag.ArchiveMonths as IEnumerable<dynamic> ?? [];
    var title = "Archive";
    if (year.HasValue) title += $" - {year}";
    if (month.HasValue) title += $" - {new DateTime(year ?? 1, month.Value, 1):MMMM}";
    ViewData["Title"] = title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Blog</a></li>
                    <li class="breadcrumb-item active">Archive</li>
                </ol>
            </nav>

            <h1 class="mb-4"><i class="fa fa-archive"></i> @title</h1>

            @if (!Model.Any())
            {
                <div class="alert alert-info">No posts in this period.</div>
            }

            @foreach (var post in Model)
            {
                <article class="card mb-3">
                    <div class="card-body">
                        <h3 class="card-title">
                            <a asp-action="Post" asp-route-slug="@post.Slug" class="text-decoration-none">@post.Title</a>
                        </h3>
                        <div class="text-muted mb-2">
                            <small>
                                <i class="fa fa-user"></i> @post.CreatedByUsername
                                <i class="fa fa-calendar ms-2"></i> @(post.PublishedAt?.ToString("MMM dd, yyyy") ?? post.CreatedAt.ToString("MMM dd, yyyy"))
                            </small>
                        </div>
                        <a asp-action="Post" asp-route-slug="@post.Slug" class="btn btn-primary btn-sm">Read More</a>
                    </div>
                </article>
            }

            @await Html.PartialAsync("_BlogPagination")
        </div>
        <div class="col-lg-4">
            @{
                var categories = ViewBag.Categories as IEnumerable<BlogCategory> ?? [];
                var tags = ViewBag.Tags as IEnumerable<BlogTag> ?? [];
                var recentPosts = ViewBag.RecentPosts as IEnumerable<BlogPost> ?? [];
            }
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fa fa-archive"></i> Archives</h5>
                </div>
                <div class="card-body py-2">
                    <ul class="list-unstyled mb-0">
                        @foreach (dynamic am in archiveMonths)
                        {
                            <li>
                                <a asp-action="Archive" asp-route-year="@am.y" asp-route-month="@am.m" class="text-decoration-none">
                                    @(new DateTime((int)am.y, (int)am.m, 1).ToString("MMMM yyyy")) (@am.Count)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fa fa-folder"></i> Categories</h5>
                </div>
                <div class="card-body py-2">
                    <ul class="list-unstyled mb-0">
                        @foreach (var cat in categories)
                        {
                            <li><a asp-action="Category" asp-route-slug="@cat.Slug" class="text-decoration-none">@cat.Name</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fa fa-tags"></i> Tags</h5>
                </div>
                <div class="card-body py-2">
                    @foreach (var tag in tags)
                    {
                        <a asp-action="Tag" asp-route-slug="@tag.Slug" class="badge bg-secondary text-decoration-none me-1 mb-1">@tag.Name</a>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fa fa-clock-o"></i> Recent Posts</h5>
                </div>
                <div class="card-body py-2">
                    <ul class="list-unstyled mb-0">
                        @foreach (var rp in recentPosts)
                        {
                            <li class="mb-1"><a asp-action="Post" asp-route-slug="@rp.Slug" class="text-decoration-none small">@rp.Title</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
