@model BlogPost
@{
    ViewData["Title"] = "Edit Post";
    var categories = ViewBag.Categories as IEnumerable<BlogCategory> ?? [];
    var tags = ViewBag.Tags as IEnumerable<BlogTag> ?? [];
    var selectedTagIds = ViewBag.SelectedTagIds as List<int> ?? [];
}

<h1><i class="fa fa-pencil"></i> Edit Post</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" name="title" class="form-control" value="@Model.Title" required maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Slug</label>
                        <input type="text" class="form-control" value="@Model.Slug" readonly />
                        <small class="text-muted">Auto-generated from title</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Excerpt</label>
                        <textarea name="excerpt" class="form-control" rows="2" maxlength="500">@Model.Excerpt</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Content</label>
                        @{ ViewData["RteName"] = "content"; ViewData["RteHeight"] = 500; ViewData["RteValue"] = Model.Content; }
                        <partial name="_RichTextEditor" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header"><strong>Publish</strong></div>
                        <div class="card-body">
                            <div class="form-check mb-2">
                                <input type="checkbox" name="isPublished" class="form-check-input" value="true" id="isPublished" checked="@Model.IsPublished" />
                                <label class="form-check-label" for="isPublished">Published</label>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" name="isFeatured" class="form-check-input" value="true" id="isFeatured" checked="@Model.IsFeatured" />
                                <label class="form-check-label" for="isFeatured">Featured Post</label>
                            </div>
                            @if (Model.IsPublished && Model.PublishedAt.HasValue)
                            {
                                <small class="text-muted">Published: @Model.PublishedAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                            }
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><strong>Category</strong></div>
                        <div class="card-body">
                            <select name="categoryId" class="form-select">
                                <option value="">-- No Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><strong>Tags</strong></div>
                        <div class="card-body" style="max-height:200px;overflow-y:auto">
                            @foreach (var tag in tags)
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input tag-checkbox" value="@tag.Id" id="tag-@tag.Id"
                                           checked="@(selectedTagIds.Contains(tag.Id))" />
                                    <label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
                                </div>
                            }
                            <input type="hidden" name="tagIds" id="tagIds" />
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><strong>Featured Image</strong></div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.FeaturedImagePath))
                            {
                                <img src="@Model.FeaturedImagePath" class="img-fluid mb-2 rounded" style="max-height:100px" />
                            }
                            <input type="file" name="featuredImage" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function() {
            var checked = document.querySelectorAll('.tag-checkbox:checked');
            var ids = Array.from(checked).map(cb => cb.value).join(',');
            document.getElementById('tagIds').value = ids;
        });
    </script>
}
