@model IEnumerable<BlogPost>
@{
    ViewData["Title"] = "Manage Blog";
    var categories = ViewBag.Categories as IEnumerable<BlogCategory> ?? [];
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fa fa-pencil-square-o"></i> @Localizer["Manage Blog"]</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> @Localizer["New Post"]</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Title"]</th>
                        <th>@Localizer["Category"]</th>
                        <th class="text-center">@Localizer["Status"]</th>
                        <th class="text-center">@Localizer["Views"]</th>
                        <th>@Localizer["Author"]</th>
                        <th>@Localizer["Date"]</th>
                        <th class="text-center">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td>
                                <strong>@post.Title</strong>
                                <br /><small class="text-muted">/blog/@post.Slug</small>
                            </td>
                            <td>@categories.FirstOrDefault(c => c.Id == post.CategoryId)?.Name</td>
                            <td class="text-center">
                                @if (post.IsPublished)
                                {
                                    <span class="badge bg-success">@Localizer["Published"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Localizer["Draft"]</span>
                                }
                                @if (post.IsFeatured)
                                {
                                    <span class="badge bg-info ms-1">@Localizer["Featured"]</span>
                                }
                            </td>
                            <td class="text-center">@post.ViewCount</td>
                            <td>@post.CreatedByUsername</td>
                            <td>@post.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning"><i class="fa fa-pencil"></i></a>
                                <form asp-action="Delete" method="post" style="display:inline"
                                      onsubmit="return confirm('Delete this post permanently?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@post.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">@Localizer["No posts yet."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
