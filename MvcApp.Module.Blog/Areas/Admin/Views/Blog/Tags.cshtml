@model IEnumerable<BlogTag>
@{
    ViewData["Title"] = "Blog Tags";
}

<h1><i class="fa fa-tags"></i> @Localizer["Blog Tags"]</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white"><strong>@Localizer["New Tag"]</strong></div>
            <div class="card-body">
                <form asp-action="CreateTag" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <input type="text" name="name" class="form-control" placeholder="@(Localizer["Tag name"])" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">@Localizer["Add Tag"]</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Name"]</th>
                            <th>@Localizer["Slug"]</th>
                            <th class="text-center">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in Model)
                        {
                            <tr>
                                <td>@tag.Name</td>
                                <td><small class="text-muted">@tag.Slug</small></td>
                                <td class="text-center">
                                    <form asp-action="DeleteTag" method="post" style="display:inline"
                                          onsubmit="return confirm('Delete this tag?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tag.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
