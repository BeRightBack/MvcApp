@model IEnumerable<ContentPage>
@{
    ViewData["Title"] = "Pages";
    var pages = Model.ToList();
}

<div class="container py-4">
    <div class="page-header d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1">Pages</h1>
            <p class="text-muted mb-0">Select a page to view its content.</p>
        </div>
    </div>

    @if (!pages.Any())
    {
        <div class="alert alert-info">No published pages yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var pg in pages)
            {
                <a asp-controller="Pages" asp-action="View" asp-route-slug="@pg.Slug"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span>
                        <strong>@pg.Title</strong>
                        <br /><small class="text-muted">/pages/@pg.Slug</small>
                    </span>
                    <i class="fa fa-chevron-right text-muted"></i>
                </a>
            }
        </div>
    }
</div>
