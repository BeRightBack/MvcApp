@model ContentPage
@{
    ViewData["Title"] = "Edit Page";
}

<h1><i class="fa fa-pencil"></i> Edit Page</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" name="title" class="form-control" required maxlength="200" value="@Model.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Slug (optional — leave blank to auto-generate from title)</label>
                        <div class="input-group">
                            <span class="input-group-text">/pages/</span>
                            <input type="text" name="slug" class="form-control font-monospace" value="@Model.Slug" placeholder="my-page" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Body</label>
                        @{
                            ViewData["PageEditorName"] = "body";
                            ViewData["PageEditorValue"] = Model.Body;
                            ViewData["PageEditorHeight"] = 420;
                        }
                        <partial name="_PageEditor" view-data="ViewData" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header"><strong>Publish</strong></div>
                        <div class="card-body">
                            <div class="form-check">
                                <input type="checkbox" name="isPublished" class="form-check-input" value="true" id="isPublished"
                                       checked="@(Model.IsPublished ? "checked" : null)" />
                                <label class="form-check-label" for="isPublished">Published</label>
                            </div>
                            <p class="text-muted small mb-0 mt-2">
                                @if (Model.PublishedAt.HasValue)
                                {
                                    <span>First published @Model.PublishedAt.Value.ToString("MMM dd, yyyy")</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><strong>Meta</strong></div>
                        <div class="card-body small">
                            <div>Author: @Model.CreatedByUsername</div>
                            <div>Created: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div>Updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                            }
                            <div class="mt-2">
                                <a asp-controller="Pages" asp-action="View" asp-route-slug="@Model.Slug" target="_blank"
                                   class="btn btn-sm btn-outline-primary"><i class="fa fa-external-link"></i> View live</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </form>
    </div>
</div>
