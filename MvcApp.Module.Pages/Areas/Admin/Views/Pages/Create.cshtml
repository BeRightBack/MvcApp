@{
    ViewData["Title"] = "Create Page";
}

<h1><i class="fa fa-plus"></i> Create Page</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" name="title" id="title" class="form-control" required maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Slug (optional — leave blank to auto-generate from title)</label>
                        <div class="input-group">
                            <span class="input-group-text">/pages/</span>
                            <input type="text" name="slug" id="slug" class="form-control font-monospace" placeholder="my-page" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Body</label>
                        @{
                            ViewData["PageEditorName"] = "body";
                            ViewData["PageEditorValue"] = "";
                            ViewData["PageEditorHeight"] = 420;
                        }
                        <partial name="_PageEditor" view-data="ViewData" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header"><strong>Publish</strong></div>
                        <div class="card-body">
                            <div class="form-check">
                                <input type="checkbox" name="isPublished" class="form-check-input" value="true" id="isPublished" />
                                <label class="form-check-label" for="isPublished">Published</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Create Page</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('title').addEventListener('input', function () {
            var slug = document.getElementById('slug');
            if (!slug.dataset.touched) {
                slug.value = this.value.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            }
        });
        document.getElementById('slug').addEventListener('input', function () {
            this.dataset.touched = '1';
        });
    </script>
}
