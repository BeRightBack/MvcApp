<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="MvcApp.ModularMonolith.ProjectTemplate.9f3b2c1a-7d4e-4b5f-a6c1-d2e3f4a5b6c7" Version="1.0.0" Language="en-US" Publisher="MvcApp" />
    <DisplayName>MvcApp Modular Monolith Project Template</DisplayName>
    <Description xml:space="preserve">Multi-project ASP.NET Core 10 modular monolith template. Creates 18 projects (Core, Services, Common, Infrastructure, Identity, Razor, Localization, Web, and 10 feature modules) named after your chosen project name.</Description>
    <Tags>aspnetcore;mvc;modular;monolith;template;mysql;signalr</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.7.2,)" />
    <Dependency Id="Microsoft.VisualStudio.MPF.15.0" DisplayName="Visual Studio MPF" Version="[15.0,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.ProjectTemplate" Path="ProjectTemplates\MvcAppMonolith" />
    <Asset Type="Microsoft.VisualStudio.Assembly" Path="TemplateWizard.dll" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="TemplateWizard.dll" />
  </Assets>
</PackageManifest>