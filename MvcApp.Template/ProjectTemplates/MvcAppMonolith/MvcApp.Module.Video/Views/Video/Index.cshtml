@model IEnumerable<VideoRoom>
@{
    ViewData["Title"] = "Video Chat";
    var canManage = User.Identity?.IsAuthenticated == true;
}

<div class="container mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width:42px;height:42px">
            <i class="fa fa-video-camera"></i>
        </div>
        <div>
            <h4 class="mb-0">Video Chat Rooms</h4>
            <small class="text-muted">Pick a spot and go live — up to 10 people can broadcast at once.</small>
        </div>
    </div>

    @if (TempData["VideoFlash"] != null)
    {
        <div class="alert alert-info">@TempData["VideoFlash"]</div>
    }

    <div class="row">
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-header">Create a room</div>
                <div class="card-body">
                    <form asp-action="CreateRoom" method="post" class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Room name</label>
                            <input type="text" name="name" class="form-control" required maxlength="100" placeholder="e.g. Night Owls" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Description (optional)</label>
                            <input type="text" name="description" class="form-control" maxlength="500" placeholder="What is this room about?" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Spots</label>
                            <select name="maxSpots" class="form-select">
                                @for (var s = 2; s <= 10; s++)
                                {
                                    <option value="@s" selected="@(s == 10)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-danger w-100">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var room in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-danger">LIVE</span>
                            <span class="badge bg-secondary">@room.MaxSpots spots</span>
                        </div>
                        <h5 class="card-title mb-1">@room.Name</h5>
                        @if (!string.IsNullOrEmpty(room.Description))
                        {
                            <p class="card-text text-muted">@room.Description</p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <a asp-action="Room" asp-route-id="@room.Id" class="btn btn-danger btn-sm">Enter Room</a>
                        @if (canManage && (User.IsInRole("Admin") || room.CreatedById == ViewBag.CurrentUserId))
                        {
                            <form asp-action="DeleteRoom" asp-route-id="@room.Id" method="post" class="m-0"
                                  onsubmit="return confirm('Delete this video room?');">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <p>No video rooms yet. Create the first one above.</p>
        </div>
    }
</div>
