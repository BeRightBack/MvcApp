@model IEnumerable<VideoRoom>
@{
    ViewData["Title"] = "Video Rooms";
    var counts = ViewBag.MessageCounts as Dictionary<int, int> ?? [];
    var lastActivity = ViewBag.LastActivity as Dictionary<int, DateTime> ?? [];
    var creators = ViewBag.Creators as Dictionary<string, UserDetails> ?? [];
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fa fa-video-camera"></i> Video Rooms</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> New Room</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Room</th>
                        <th class="text-center">Messages</th>
                        <th>Last Activity</th>
                        <th>Created By</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>
                                <strong>@room.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <br /><small class="text-muted">@room.Description</small>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@(counts.TryGetValue(room.Id, out var c) ? c : 0)</span>
                            </td>
                            <td>
                                @if (lastActivity.TryGetValue(room.Id, out var last))
                                {
                                    @last.ToLocalTime().ToString("g")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (creators.TryGetValue(room.CreatedById ?? "", out var creator))
                                {
                                    @creator.UserName
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (room.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Messages" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary"><i class="fa fa-list"></i> Messages</a>
                                <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-outline-secondary"><i class="fa fa-pencil"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@room.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this room and all its messages?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No video rooms yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
