@model IEnumerable<VideoRoomMessage>
@{
    var room = ViewBag.Room as VideoRoom;
    var page = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int t ? t : 1;
    var senders = ViewBag.Senders as Dictionary<string, UserDetails> ?? [];
    ViewData["Title"] = $"Messages - {room?.Name}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fa fa-video-camera"></i> @room?.Name — Messages</h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa fa-arrow-left"></i> Rooms</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var message in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="me-3">
                            <div>
                                <strong>@(senders.TryGetValue(message.SenderId ?? "", out var s) ? s.UserName : (message.SenderUsername ?? "Unknown"))</strong>
                                <small class="text-muted ms-2">@message.MessageSent.ToLocalTime().ToString("g")</small>
                            </div>
                            <div class="mt-1">@message.Content</div>
                        </div>
                        <form asp-action="DeleteMessage" asp-route-id="@message.Id" method="post"
                              onsubmit="return confirm('Delete this message?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></button>
                        </form>
                    </li>
                }
                @if (!Model.Any())
                {
                    <li class="list-group-item text-center text-muted py-4">No messages in this room.</li>
                }
            </ul>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Messages" asp-route-id="@room?.Id" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
