@model MvcApp.Module.IPTV.Models.SubscriptionViewModels.SubscriptionPlanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = @Localizer["Edit Plan - Admin"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="IptvPlan" asp-action="Index">@Localizer["Plans"]</a></li>
        <li class="breadcrumb-item active">@Localizer["Edit"]</li>
    </ol>
</nav>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Localizer["Edit Plan"]</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DescriptionShort" class="form-label">@Localizer["Short Description"]</label>
                <input asp-for="DescriptionShort" class="form-control" />
                <span asp-validation-for="DescriptionShort" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">@Localizer["Full Description"]</label>
                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <h5>@Localizer["Subscription Details"]</h5>
            <div id="detailsContainer">
                @for (var i = 0; i < Model.SubscriptionDetails.Count; i++)
                {
                    <div class="detail-row card mb-2">
                        <div class="card-body">
                            <div class="row g-2">
                                <input type="hidden" name="SubscriptionDetails[@i].Id" value="@Model.SubscriptionDetails[i].Id" />
                                <div class="col-md-4">
                                    <label class="form-label small">@Localizer["Description"]</label>
                                    <input name="SubscriptionDetails[@i].Description" class="form-control" value="@Model.SubscriptionDetails[i].Description" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">@Localizer["Price"]</label>
                                    <input name="SubscriptionDetails[@i].Price" class="form-control" type="number" step="0.01" value="@Model.SubscriptionDetails[i].Price" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">@Localizer["Duration (months)"]</label>
                                    <input name="SubscriptionDetails[@i].DurationInMonths" class="form-control" type="number" value="@Model.SubscriptionDetails[i].DurationInMonths" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">@Localizer["Duration (hours)"]</label>
                                    <input name="SubscriptionDetails[@i].DurationInHours" class="form-control" type="number" value="@Model.SubscriptionDetails[i].DurationInHours" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" name="action" value="removeDetail_@i" class="btn btn-danger btn-sm">@Localizer["Remove"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button type="submit" name="action" value="addDetail" class="btn btn-outline-primary btn-sm mb-3">+ @Localizer["Add Detail"]</button>

            <div>
                <button type="submit" name="action" value="save" class="btn btn-primary">@Localizer["Save"]</button>
                <a asp-controller="IptvPlan" asp-action="Index" class="btn btn-secondary">@Localizer["Back to List"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
