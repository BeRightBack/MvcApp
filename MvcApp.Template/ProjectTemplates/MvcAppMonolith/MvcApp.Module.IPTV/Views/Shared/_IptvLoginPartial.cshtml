@using System.Security.Claims
@using Microsoft.AspNetCore.Http.Features

<ul class="navbar-nav ml-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Manage/Index" title="Manage">
                @if (User.Identity != null)
                {
                    @User.Identity.Name
                }
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "IptvHome")" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">@Localizer["Logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Register" asp-route-returnUrl="@Url.Action("Index", "IptvHome")">@Localizer["Register"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Index", "IptvHome")">@Localizer["Login"]</a>
        </li>
    }
</ul>
