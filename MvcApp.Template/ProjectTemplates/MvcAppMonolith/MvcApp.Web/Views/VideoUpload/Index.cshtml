@model IEnumerable<MvcApp.Core.VideoUpload>
@using MvcApp.Core
@{
    ViewData["Title"] = "Videos";
    var category = ViewBag.Category as string;
    var search = ViewBag.Search as string ?? "";
    var categories = (VideoCategory[])ViewBag.Categories;
    var categoryColors = new Dictionary<VideoCategory, string> {
        { VideoCategory.General, "secondary" }, { VideoCategory.Fitness, "success" },
        { VideoCategory.Travel, "info" }, { VideoCategory.Lifestyle, "primary" },
        { VideoCategory.Dance, "warning" }, { VideoCategory.Music, "danger" },
        { VideoCategory.Adult, "dark" }, { VideoCategory.Other, "secondary" }
    };
}

<section class="py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold"><i class='bx bx-video'></i> Videos</h2>
                <p class="text-muted mb-0">Watch and share video clips</p>
            </div>
            <a asp-action="Upload" class="btn btn-primary rounded-pill">
                <i class='bx bx-upload'></i> Upload Video
            </a>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="get" class="row g-2 mb-4">
            <div class="col-auto">
                <select name="category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(category == c.ToString())">@c</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search videos..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Clear</a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class='bx bx-video' style="font-size:4rem; color:#6c757d;"></i>
                <h4 class="mt-3">No videos yet</h4>
                <p class="text-muted">Be the first to upload a video!</p>
                <a asp-action="Upload" class="btn btn-primary rounded-pill">Upload Video</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var video in Model)
                {
                    var color = categoryColors.ContainsKey(video.Category) ? categoryColors[video.Category] : "secondary";
                    var thumbUrl = !string.IsNullOrEmpty(video.ThumbnailFilename)
                        ? $"/Videos/{video.User?.UserName}/{video.ThumbnailFilename}"
                        : null;
                    var mins = video.DurationSeconds / 60;
                    var secs = video.DurationSeconds % 60;
                    <div class="col-md-3 col-sm-6">
                        <a asp-action="Watch" asp-route-id="@video.Id" class="text-decoration-none">
                            <div class="card border-0 rounded-4 overflow-hidden shadow-sm h-100">
                                <div class="position-relative bg-dark" style="height:180px;">
                                    @if (thumbUrl != null)
                                    {
                                        <img src="@thumbUrl" class="w-100 h-100" style="object-fit:cover;"
                                             onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center h-100\'><i class=\'bx bx-play-circle text-white\' style=\'font-size:3rem;\'></i></div>';" alt="@video.Title">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100">
                                            <i class='bx bx-play-circle text-white' style="font-size:3rem;"></i>
                                        </div>
                                    }
                                    @if (video.DurationSeconds > 0)
                                    {
                                        <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark bg-opacity-75">
                                            @mins:@secs.ToString("D2")
                                        </span>
                                    }
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-@color bg-opacity-75">@video.Category</span>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate">@video.Title</h6>
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span><i class='bx bx-user'></i> @video.User?.KnownAs</span>
                                        <span><i class='bx bx-play'></i> @video.ViewCount views</span>
                                    </div>
                                    <div class="text-muted small">
                                        <i class='bx bx-time'></i> @video.UploadedAt.ToString("MMM d, yyyy")
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-category="@category" asp-route-search="@search">Previous</a>
                            </li>
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-category="@category" asp-route-search="@search">@i</a>
                                </li>
                            }
                            <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-category="@category" asp-route-search="@search">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</section>
