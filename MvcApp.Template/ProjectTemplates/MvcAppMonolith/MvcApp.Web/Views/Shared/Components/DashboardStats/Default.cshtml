@model MvcApp.Web.Components.DashboardStatsViewModel

<div class="row g-4 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <i class="bx bx-user stat-icon"></i>
            <div class="stat-value">@Model.TotalUsers.ToString("N0")</div>
            <div class="stat-label">@Localizer["Active Users"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:var(--template-secondary);">
            <i class="bx bx-user-plus stat-icon"></i>
            <div class="stat-value">@Model.NewUsers30Days.ToString("N0")</div>
            <div class="stat-label">@Localizer["New Members (30 days)"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:var(--template-accent);">
            <i class="bx bx-history stat-icon"></i>
            <div class="stat-value">@Model.AuditEvents.ToString("N0")</div>
            <div class="stat-label">@Localizer["Audit Events"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:#10b981;">
            <i class="bx bx-puzzle stat-icon"></i>
            <div class="stat-value">@Model.EnabledModules.ToString("N0")</div>
            <div class="stat-label">@Localizer["Enabled Modules"]</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card p-4 h-100">
            <h5 class="fw-bold mb-3">@Localizer["Recent Activity"]</h5>
            @if (Model.RecentActivity.Count == 0)
            {
                <p class="text-muted small mb-3">@Localizer["No recent activity to display."]</p>
            }
            else
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var log in Model.RecentActivity)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
                            <div class="text-truncate">
                                <span class="badge bg-light text-dark border me-2">@log.Action</span>
                                <span class="small">@log.Entity@(string.IsNullOrWhiteSpace(log.EntityId) ? "" : $" #{log.EntityId}")</span>
                            </div>
                            <span class="text-muted small text-nowrap">@log.Timestamp.ToLocalTime().ToString("g")</span>
                        </li>
                    }
                </ul>
            }
            <a class="btn btn-outline-primary btn-sm align-self-start mt-auto" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                <i class="bx bx-history me-1"></i>@Localizer["View Audit Logs"]
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <h5 class="fw-bold mb-3">@Localizer["Quick Actions"]</h5>
            <div class="d-grid gap-2">
                <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bx bx-grid-alt me-1"></i>@Localizer["Open Dashboard"]
                </a>
                <a class="btn btn-outline-primary btn-sm" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="bx bx-user-plus me-1"></i>@Localizer["Manage Users"]
                </a>
                <a class="btn btn-outline-primary btn-sm" asp-area="Admin" asp-controller="Templates" asp-action="Index">
                    <i class="bx bx-palette me-1"></i>@Localizer["Site Templates"]
                </a>
            </div>
        </div>
    </div>
</div>
