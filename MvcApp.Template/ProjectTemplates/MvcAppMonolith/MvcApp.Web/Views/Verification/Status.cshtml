@model MvcApp.Core.VerificationRequest?
@{
    ViewData["Title"] = "Get Verified";
    var hasRequest = Model != null;
    var isPending = hasRequest && Model!.Status == VerificationStatus.Pending;
    var isRejected = hasRequest && Model!.Status == VerificationStatus.Rejected;
    var random = new Random();
    var challengeNumber = random.Next(1000, 9999);
}

<section class="py-4">
    <div class="container" style="max-width:650px;">
        <h2 class="fw-bold mb-4"><i class='bx bx-check-shield'></i> Get Verified</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">How it works</h5>
                <ol class="text-muted">
                    <li class="mb-2">Take a selfie holding a piece of paper with this number written on it:</li>
                </ol>
                <div class="text-center my-3">
                    <span class="display-4 fw-bold text-primary" id="challengeNum">@challengeNumber</span>
                </div>
                <ol class="text-muted" start="2">
                    <li class="mb-2">Upload the selfie below</li>
                    <li>Our team will review and approve within 24 hours</li>
                </ol>
            </div>
        </div>

        @if (isPending)
        {
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4 text-center">
                    <i class='bx bx-time-five text-warning' style="font-size:3rem;"></i>
                    <h4 class="mt-3">Verification Pending</h4>
                    <p class="text-muted">Your verification request is being reviewed. This usually takes less than 24 hours.</p>
                    <div class="text-muted small">
                        Submitted: @Model!.RequestedAt.ToString("MMM d, yyyy 'at' h:mm tt")<br/>
                        Number in photo: <strong>@Model.DisplayNumber</strong>
                    </div>
                </div>
            </div>
        }
        else if (isRejected)
        {
            <div class="card border-0 rounded-4 shadow-sm border-danger">
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <i class='bx bx-x-circle text-danger' style="font-size:3rem;"></i>
                        <h4 class="mt-3">Verification Rejected</h4>
                        @if (!string.IsNullOrEmpty(Model!.AdminNotes))
                        {
                            <p class="text-muted">Reason: @Model.AdminNotes</p>
                        }
                    </div>
                    <p class="text-center text-muted">You can submit a new verification request.</p>
                </div>
            </div>

            <div class="card border-0 rounded-4 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Resubmit Verification</h5>
                    <form asp-action="Submit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Number in your photo</label>
                            <input type="text" name="displayNumber" class="form-control" required placeholder="Enter the number you wrote on paper" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Selfie with number</label>
                            <input type="file" name="selfieFile" class="form-control" accept="image/jpeg,image/png,image/webp" required />
                            <div class="form-text">JPEG, PNG, or WebP — Max 10MB</div>
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class='bx bx-upload'></i> Submit New Request
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Submit Your Verification</h5>
                    <form asp-action="Submit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Number in your photo</label>
                            <input type="text" name="displayNumber" class="form-control" required placeholder="Enter the number you wrote on paper"
                                   value="@(ViewBag.DisplayNumber ?? "")" />
                            <div class="form-text">Write <strong>@challengeNumber</strong> on a piece of paper and hold it in your selfie</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Selfie with number</label>
                            <input type="file" name="selfieFile" class="form-control" accept="image/jpeg,image/png,image/webp" required />
                            <div class="form-text">JPEG, PNG, or WebP — Max 10MB — Must clearly show your face and the number</div>
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class='bx bx-check-shield'></i> Submit Verification
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>
