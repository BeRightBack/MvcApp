@{
    ViewData["Title"] = "Verified";
}

<section class="py-4">
    <div class="container text-center" style="max-width:500px;">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-5">
                <i class='bx bx-check-shield text-success' style="font-size:4rem;"></i>
                <h3 class="mt-3 fw-bold">You're Verified!</h3>
                <p class="text-muted">Your profile has a verified badge. Other members can trust that you are who you say you are.</p>
                <a asp-controller="Members" asp-action="Details" asp-route-id="@User.Identity?.Name" class="btn btn-primary rounded-pill px-4">
                    View My Profile
                </a>
            </div>
        </div>
    </div>
</section>
