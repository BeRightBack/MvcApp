@model IEnumerable<MvcApp.Core.VideoUpload>
@using MvcApp.Core
@{
    ViewData["Title"] = "Video Moderation";
    var filter = ViewBag.Filter as string ?? "pending";
    var pendingCount = (int)ViewBag.PendingCount;
    var categoryColors = new Dictionary<VideoCategory, string> {
        { VideoCategory.General, "secondary" }, { VideoCategory.Fitness, "success" },
        { VideoCategory.Travel, "info" }, { VideoCategory.Lifestyle, "primary" },
        { VideoCategory.Dance, "warning" }, { VideoCategory.Music, "danger" },
        { VideoCategory.Adult, "dark" }, { VideoCategory.Other, "secondary" }
    };
}

<section class="py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold"><i class='bx bx-video'></i> Video Moderation</h2>
                <p class="text-muted mb-0">
                    @if (pendingCount > 0)
                    {
                        <span class="badge bg-danger me-2">@pendingCount pending</span>
                    }
                    @ViewBag.TotalCount total videos
                </p>
            </div>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="mb-3">
            @{
                var pendingClass = filter == "pending" ? "btn-danger" : "btn-outline-danger";
                var approvedClass = filter == "approved" ? "btn-success" : "btn-outline-success";
                var rejectedClass = filter == "rejected" ? "btn-secondary" : "btn-outline-secondary";
            }
            <div class="btn-group">
                <a asp-action="Index" asp-route-filter="pending" class="btn @pendingClass">
                    Pending <span class="badge bg-white text-danger ms-1">@pendingCount</span>
                </a>
                <a asp-action="Index" asp-route-filter="approved" class="btn @approvedClass">Approved</a>
                <a asp-action="Index" asp-route-filter="rejected" class="btn @rejectedClass">Rejected</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class='bx bx-check-circle' style="font-size:4rem; color:#27ae60;"></i>
                <h4 class="mt-3">All clear!</h4>
                <p class="text-muted">No videos to review in this category.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var video in Model)
                {
                    var color = categoryColors.ContainsKey(video.Category) ? categoryColors[video.Category] : "secondary";
                    var thumbUrl = !string.IsNullOrEmpty(video.ThumbnailFilename)
                        ? $"/Videos/{video.User?.UserName}/{video.ThumbnailFilename}"
                        : null;
                    <div class="col-md-3">
                        <div class="card border-0 rounded-4 overflow-hidden shadow-sm h-100">
                            <div class="position-relative bg-dark" style="height:180px;">
                                @if (thumbUrl != null)
                                {
                                    <img src="@thumbUrl" class="w-100 h-100" style="object-fit:cover;"
                                         onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center h-100\'><i class=\'bx bx-play-circle text-white\' style=\'font-size:2.5rem;\'></i></div>';" alt="@video.Title">
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100">
                                        <i class='bx bx-play-circle text-white' style="font-size:2.5rem;"></i>
                                    </div>
                                }
                                <span class="position-absolute top-0 end-0 m-2 badge @(video.IsApproved ? "bg-success" : "bg-warning text-dark")">
                                    @(video.IsApproved ? "Approved" : "Pending")
                                </span>
                                <span class="position-absolute top-0 start-0 m-2 badge bg-@color bg-opacity-75">@video.Category</span>
                            </div>
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-1 text-truncate">@video.Title</h6>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">
                                        <i class='bx bx-user'></i> @video.User?.UserName
                                    </small>
                                    <small class="text-muted">@video.ViewCount views</small>
                                </div>
                                <div class="text-muted small mb-2">@video.UploadedAt.ToString("MMM d, yyyy")</div>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (!video.IsApproved)
                                    {
                                        <form asp-action="Approve" asp-route-id="@video.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill">
                                                <i class='bx bx-check'></i> Approve
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reject" asp-route-id="@video.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-warning rounded-pill">
                                                <i class='bx bx-x'></i> Reject
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@video.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Permanently delete this video?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class='bx bx-trash'></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-filter="@filter">Previous</a>
                            </li>
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-filter="@filter">@i</a>
                                </li>
                            }
                            <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-filter="@filter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</section>
