@using MvcApp.Web.Areas.Admin.Models.UserViewModels
@model RoleViewModel

@{
    ViewData["Title"] = "Roles";
}

<div class="bg-primary m-1 p-1 text-white"><h4>Edit Role</h4></div>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="get" asp-action="Edit">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <input type="text" name="searchQuery" value="@ViewData["SearchQuery"]" class="form-control" placeholder="Search users..." />
        <button type="submit" class="btn btn-primary mt-2">Search</button>
    </div>
</form>

<form asp-action="Edit" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <h6 class="bg-info p-1 text-white">Add To @Model.Name</h6>
    <table class="table table-bordered table-sm">
        @if (Model.NonMembers.Count() == 0)
        {
            <tr><td colspan="2">All Users Are Members</td></tr>
        }
        else
        {
            @foreach (UserProfile user in Model.NonMembers)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        <input type="checkbox" name="IdsToAdd" value="@user.Id">
                    </td>
                </tr>
            }
        }
    </table>

    <h6 class="bg-info p-1 text-white">Remove From @Model.Name</h6>
    <table class="table table-bordered table-sm">
        @if (Model.Members.Count() == 0)
        {
            <tr><td colspan="2">No Users Are Members</td></tr>
        }
        else
        {
            @foreach (UserProfile user in Model.Members)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        <input type="checkbox" name="IdsToDelete" value="@user.Id">
                    </td>
                </tr>
            }
        }
    </table>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewData["TotalPages"]!; i++)
        {
            <li class="page-item @(i == (int)ViewData["PageNumber"]! ? "active" : "")">
                <a class="page-link" asp-action="Edit" asp-route-id="@Model.Id" asp-route-pageNumber="@i" asp-route-searchQuery="@ViewData["SearchQuery"]">@i</a>
            </li>
        }
    </ul>
</nav>

