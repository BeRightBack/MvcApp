@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1>Dashboard</h1>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#eef2ff;color:#4f46e5">
                <i class='bx bxs-user'></i>
            </div>
            <div class="stat-label">Total Users</div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef2f2;color:#ef4444">
                <i class='bx bxs-shield'></i>
            </div>
            <div class="stat-label">Roles</div>
            <div class="stat-value">@ViewBag.TotalRoles</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#f0fdf4;color:#22c55e">
                <i class='bx bxs-flag-alt'></i>
            </div>
            <div class="stat-label">Languages</div>
            <div class="stat-value">@ViewBag.TotalLanguages</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fffbeb;color:#f59e0b">
                <i class='bx bxs-translate'></i>
            </div>
            <div class="stat-label">Translations</div>
            <div class="stat-value">@ViewBag.TotalTranslations</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#f5f3ff;color:#8b5cf6">
                <i class='bx bxs-bar-chart-alt-2'></i>
            </div>
            <div class="stat-label">Total Visits</div>
            <div class="stat-value">@ViewBag.TotalVisitors</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#ecfdf5;color:#10b981">
                <i class='bx bxs-group'></i>
            </div>
            <div class="stat-label">Unique Visitors</div>
            <div class="stat-value">@ViewBag.UniqueVisitors</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <span>Recent Users</span>
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-sm btn-outline-primary btn-admin">View All</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Created</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in ViewBag.RecentUsers as List<MvcApp.Core.UserDetails> ?? new())
                {
                    <tr>
                        <td><strong>@user.UserName</strong></td>
                        <td>@user.Email</td>
                        <td>@user.Created.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (user.EmailConfirmed)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
