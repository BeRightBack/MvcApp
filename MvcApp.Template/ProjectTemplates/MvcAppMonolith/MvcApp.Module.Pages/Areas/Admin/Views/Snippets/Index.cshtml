@model IEnumerable<ContentPageSnippet>
@{
    ViewData["Title"] = "Page Snippets";
    var snippets = Model.ToList();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fa fa-cubes"></i> Page Snippets</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> New Snippet</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="alert alert-info">
        Snippets appear in the <strong>Snippets &amp; Components</strong> library of the page editor. Admins can
        insert them into page bodies with one click. System snippets ship with the platform.
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-center">Type</th>
                        <th>Updated</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in snippets)
                    {
                        <tr>
                            <td><strong>@s.Name</strong></td>
                            <td><span class="badge bg-secondary">@s.Category</span></td>
                            <td><small class="text-muted">@s.Description</small></td>
                            <td class="text-center">
                                @if (s.IsSystem)
                                {
                                    <span class="badge bg-info text-dark">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">Custom</span>
                                }
                            </td>
                            <td>@(s.UpdatedAt?.ToString("MMM dd, yyyy") ?? s.CreatedAt.ToString("MMM dd, yyyy"))</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning"><i class="fa fa-pencil"></i></a>
                                <form asp-action="Delete" method="post" style="display:inline"
                                      onsubmit="return confirm('Delete this snippet permanently?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!snippets.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No snippets yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
