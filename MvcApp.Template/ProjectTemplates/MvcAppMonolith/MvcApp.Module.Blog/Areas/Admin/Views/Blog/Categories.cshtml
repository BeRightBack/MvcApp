@model IEnumerable<BlogCategory>
@{
    ViewData["Title"] = "Blog Categories";
}

<h1><i class="fa fa-folder"></i> Blog Categories</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white"><strong>New Category</strong></div>
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <input type="text" name="name" class="form-control" placeholder="Category name" required />
                    </div>
                    <div class="mb-2">
                        <input type="text" name="description" class="form-control" placeholder="Description (optional)" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Add Category</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>
                                    <form asp-action="EditCategory" method="post" class="d-flex align-items-center gap-2" style="display:inline-flex">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <input type="text" name="name" class="form-control form-control-sm" value="@cat.Name" style="width:150px" required />
                                        <input type="text" name="description" class="form-control form-control-sm" value="@cat.Description" style="width:200px" />
                                        <button type="submit" class="btn btn-sm btn-warning"><i class="fa fa-save"></i></button>
                                    </form>
                                </td>
                                <td><small class="text-muted">@cat.Slug</small></td>
                                <td><small class="text-muted">@cat.Description</small></td>
                                <td class="text-center">
                                    <form asp-action="DeleteCategory" method="post" style="display:inline"
                                          onsubmit="return confirm('Delete this category?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
