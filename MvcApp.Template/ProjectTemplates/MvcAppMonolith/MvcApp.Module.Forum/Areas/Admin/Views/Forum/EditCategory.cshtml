@model ForumCategory
@{
    ViewData["Title"] = "Edit Category";
}

<h1><i class="fa fa-pencil"></i> Edit Category</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="EditCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label fw-bold">Name</label>
                <input type="text" name="name" class="form-control" value="@Model.Name" required maxlength="100" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <input type="text" name="description" class="form-control" value="@Model.Description" maxlength="500" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Sort Order</label>
                <input type="number" name="sortOrder" class="form-control" value="@Model.SortOrder" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
