@model Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as IEnumerable<Product>;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Store</a></li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.Category.Id">@Model.Category.Name</a></li>
        }
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-6">
        <img src="@(Model.ImageUrl ?? "/images/no-image.png")" class="img-fluid rounded shadow" alt="@Model.Name">
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        @if (Model.ComparePrice.HasValue && Model.ComparePrice > Model.Price)
        {
            <p class="mb-1">
                <span class="h2 text-primary fw-bold">$@Model.Price.ToString("F2")</span>
                <span class="h5 text-muted text-decoration-line-through ms-2">$@Model.ComparePrice.Value.ToString("F2")</span>
            </p>
        }
        else
        {
            <p class="h2 text-primary fw-bold">$@Model.Price.ToString("F2")</p>
        }

        @if (Model.StockQuantity > 0)
        {
            <p class="text-success"><i class="fa fa-check-circle"></i> In Stock</p>
        }
        else
        {
            <p class="text-danger"><i class="fa fa-times-circle"></i> Out of Stock</p>
        }

        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="text-muted">@Model.ShortDescription</p>
        }

        <form asp-action="AddToCart" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="input-group mb-3" style="max-width:200px;">
                <input type="number" name="quantity" value="1" min="1" max="99" class="form-control text-center" />
                <button type="submit" class="btn btn-primary"><i class="fa fa-cart-plus"></i> Add to Cart</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <hr />
            <h5>Description</h5>
            <div class="mt-2">@Html.Raw(Model.Description)</div>
        }
    </div>
</div>

@if (related != null && related.Any())
{
    <hr />
    <h3>Related Products</h3>
    <div class="row">
        @foreach (var p in related)
        {
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card h-100 shadow-sm">
                    <a asp-action="Details" asp-route-slug="@p.Slug">
                        <img src="@(p.ImageUrl ?? "/images/no-image.png")" class="card-img-top" alt="@p.Name" style="height:150px;object-fit:cover;">
                    </a>
                    <div class="card-body">
                        <h6><a asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none text-dark">@p.Name</a></h6>
                        <strong class="text-primary">$@p.Price.ToString("F2")</strong>
                    </div>
                </div>
            </div>
        }
    </div>
}
