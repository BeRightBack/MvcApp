@model IEnumerable<Product>
@{
    ViewData["Title"] = "Store";
    var categories = ViewBag.Categories as IEnumerable<ProductCategory>;
    var selectedCategory = ViewBag.SelectedCategory as int?;
}

<h1>Store</h1>

<div class="row mb-4">
    <div class="col-12">
        <div class="btn-group flex-wrap" role="group">
            <a asp-action="Index" class="btn btn-outline-primary @(selectedCategory == null ? "active" : "")">All</a>
            @foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-outline-primary @(selectedCategory == cat.Id ? "active" : "")">@cat.Name</a>
            }
        </div>
    </div>
</div>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                <a asp-action="Details" asp-route-slug="@product.Slug">
                    <img src="@(product.ImageUrl ?? "/images/no-image.png")" class="card-img-top" alt="@product.Name" style="height:200px;object-fit:cover;">
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-slug="@product.Slug" class="text-decoration-none text-dark">@product.Name</a>
                    </h5>
                    <p class="card-text small text-muted flex-grow-1">@product.ShortDescription</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <div>
                            <strong class="text-primary h5">$@product.Price.ToString("F2")</strong>
                            @if (product.ComparePrice.HasValue && product.ComparePrice > product.Price)
                            {
                                <small class="text-muted text-decoration-line-through ms-2">$@product.ComparePrice.Value.ToString("F2")</small>
                            }
                        </div>
                        <form asp-action="AddToCart" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-cart-plus"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-page="@i" asp-route-categoryId="@selectedCategory" class="page-link">@i</a>
                </li>
            }
        </ul>
    </nav>
}
