<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MvcApp.Core\MvcApp.Core.csproj" />
    <ProjectReference Include="..\MvcApp.Infrastruccture\MvcApp.Infrastructure.csproj" />
    <ProjectReference Include="..\MvcApp.Localization\MvcApp.Localization.csproj" />
  </ItemGroup>



</Project>
