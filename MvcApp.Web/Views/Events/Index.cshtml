@model IEnumerable<MvcApp.Core.Event>
@using MvcApp.Core
@{
    ViewData["Title"] = "Events";
    var categories = ViewBag.Categories as List<EventCategory> ?? [];
}

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold" style="font-family:'Playfair Display',Georgia,serif;">Events</h1>
                <p class="text-muted">Discover what's happening around you</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="MyEvents" class="btn btn-outline-secondary rounded-pill">
                    <i class='bx bx-calendar'></i> My Events
                </a>
                <a asp-action="Create" class="btn rounded-pill" style="background:linear-gradient(135deg,#fdcb6e,#e74c6f); color:#fff;">
                    <i class='bx bx-plus'></i> Create Event
                </a>
            </div>
        </div>

        <!-- Filters -->
        <form method="get" class="card border-0 rounded-4 shadow-sm p-4 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">City</label>
                    <input type="text" name="city" value="@ViewBag.City" class="form-control rounded-pill" placeholder="Search by city..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Category</label>
                    <select name="categoryId" class="form-select rounded-pill">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small">From</label>
                    <input type="date" name="from" value="@ViewBag.From" class="form-control rounded-pill" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small">To</label>
                    <input type="date" name="to" value="@ViewBag.To" class="form-control rounded-pill" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn rounded-pill" style="background:linear-gradient(135deg,#fdcb6e,#e74c6f); color:#fff;">
                        <i class='bx bx-filter-alt'></i> Filter
                    </button>
                </div>
            </div>
        </form>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var evt in Model)
                {
                    var goingCount = evt.RSVPs?.Count(r => r.Status == RSVPStatus.Going) ?? 0;
                    <div class="col-md-4">
                        <a asp-action="Details" asp-route-id="@evt.Id" class="text-decoration-none">
                            <div class="card border-0 rounded-4 overflow-hidden shadow-sm h-100 event-card">
                                <div class="position-relative" style="height:200px; background:linear-gradient(135deg,#667eea,#764ba2);">
                                    @if (!string.IsNullOrEmpty(evt.ImageUrl))
                                    {
                                        <img src="@evt.ImageUrl" class="w-100 h-100" style="object-fit:cover;" alt="@evt.Title">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100">
                                            <i class='bx bx-calendar-event' style="font-size:4rem; color:rgba(255,255,255,0.3);"></i>
                                        </div>
                                    }
                                    @if (evt.Category != null)
                                    {
                                        <span class="position-absolute top-0 end-0 m-2 badge bg-white text-dark">
                                            <i class='bx @(evt.Category!.Icon ?? "bx-calendar-event")'></i> @evt.Category!.Name
                                        </span>
                                    }
                                    <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75">
                                        @evt.EventDate.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-1 text-dark">@evt.Title</h6>
                                    <div class="text-muted small mb-1">
                                        <i class='bx bx-map-pin'></i> @evt.City, @evt.Country
                                    </div>
                                    <div class="text-muted small mb-1">
                                        <i class='bx bx-time-five'></i> @evt.EventDate.ToString("hh:mm tt")
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-muted small">
                                            <i class='bx bx-group'></i> @goingCount going
                                            @if (evt.MaxAttendees > 0)
                                            {
                                                <span>/ @evt.MaxAttendees</span>
                                            }
                                        </span>
                                        <small class="text-muted">by @evt.Creator?.KnownAs</small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-city="@ViewBag.City" asp-route-categoryId="@ViewBag.CategoryId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class='bx bx-calendar' style="font-size:4rem; color:#e74c6f;"></i>
                <h4 class="mt-3">No events found</h4>
                <p class="text-muted">Try adjusting your filters or create a new event!</p>
            </div>
        }
    </div>
</section>
