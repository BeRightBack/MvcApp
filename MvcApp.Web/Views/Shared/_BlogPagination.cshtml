@{
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var slug = ViewBag.Slug as string;
    var query = ViewBag.SearchQuery as string;
    var year = ViewBag.ArchiveYear as int?;
    var month = ViewBag.ArchiveMonth as int?;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@GetPageUrl(page - 1, action, slug, query, year, month)">Previous</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="@GetPageUrl(i, action, slug, query, year, month)">@i</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@GetPageUrl(page + 1, action, slug, query, year, month)">Next</a>
            </li>
        </ul>
    </nav>
}

@functions {
    string GetPageUrl(int p, string action, string? slug, string? query, int? year, int? month)
    {
        var url = Url.Action(action, new { slug, q = query, year, month, page = p });
        return url ?? "#";
    }
}
