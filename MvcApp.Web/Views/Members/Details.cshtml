@model MvcApp.Web.Models.MemberProfileViewModel
@using MvcApp.Core
@using MvcApp.Infrastructure.Extentions
@{
    ViewData["Title"] = Model.Member.KnownAs;
    var m = Model.Member;
    var categoryColors = new Dictionary<InterestCategory, string> {
        { InterestCategory.Interest, "primary" }, { InterestCategory.Fantasy, "danger" },
        { InterestCategory.Hobby, "success" }, { InterestCategory.Lifestyle, "info" },
        { InterestCategory.Kink, "warning" }
    };
}

<section class="py-4">
    <div class="container">
        <a asp-controller="Discover" asp-action="Index" class="btn btn-outline-secondary rounded-pill mb-4">
            <i class='bx bx-arrow-back'></i> Back to Discover
        </a>

        <div class="row g-4">
            <!-- Profile Header -->
            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
                    <div class="position-relative" style="height:300px;">
                        <img src="@m.MainPhotoUrl" class="w-100 h-100" style="object-fit:cover;"
                             onerror="this.onerror=null;this.src='/images/default-user.png';" alt="@m.KnownAs">
                        @if (m.LastActive.IsOnline())
                        {
                            <span class="online-dot" title="Online now" style="width:16px;height:16px;border:3px solid #fff;"></span>
                        }
                    </div>
                    <div class="card-body text-center p-4">
                        <h3 class="fw-bold mb-1">
                            @m.KnownAs, @m.Age
                            @if (m.IsVerified)
                            {
                                <i class='bx bxs-check-circle text-info' title="Verified"></i>
                            }
                            @if (m.IsVip)
                            {
                                <i class='bx bxs-crown text-warning' title="VIP Member"></i>
                            }
                        </h3>
                        <div class="text-muted mb-2">
                            <i class='bx bx-map-pin'></i> @m.City
                            @if (!string.IsNullOrEmpty(m.State))
                            {
                                <span>, @m.State</span>
                            }
                        </div>
                        <div class="text-muted small mb-3">
                            @if (m.LastActive.IsOnline())
                            {
                                <span class="online-text"><i class='bx bx-circle text-success'></i> Online now</span>
                            }
                            else
                            {
                                <span><i class='bx bx-time-five'></i> Active @m.LastActive.TimeAgo()</span>
                            }
                        </div>

                        <div class="d-flex justify-content-center gap-2 mb-3">
                            <form asp-controller="Likes" asp-action="Toggle" method="post">
                                <input type="hidden" name="likedUserId" value="@m.Id" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = m.Username })" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn rounded-pill @(m.IsLikedByYou ? "btn-danger" : "btn-outline-danger")">
                                    <i class='bx @(m.IsLikedByYou ? "bxs-heart" : "bx-heart")'></i> @(m.IsLikedByYou ? "Liked" : "Like")
                                </button>
                            </form>
                            <a class="btn rounded-pill btn-outline-primary" href="/Messages/Chat/@m.Id">
                                <i class='bx bx-message-rounded-dots'></i> Message
                            </a>
                        </div>

                        @if (m.MessagingPermission == MessagingPermission.VipOnly)
                        {
                            <div class="alert alert-warning rounded-3 py-2 px-3 small mb-3">
                                <i class='bx bx-crown'></i> VIP Only — This member only accepts messages from VIP users
                            </div>
                        }
                        else if (m.MessagingPermission == MessagingPermission.MatchesOnly)
                        {
                            <div class="alert alert-info rounded-3 py-2 px-3 small mb-3">
                                <i class='bx bx-heart'></i> Matches Only — You must be a mutual match to message this user
                            </div>
                        }

                        <div class="text-end mb-3">
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#reportModal">
                                <i class='bx bx-flag'></i> Report
                            </button>
                        </div>

                        <div class="modal fade" id="reportModal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4">
                                    <form asp-controller="Report" asp-action="Submit" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reportedUserId" value="@m.Id" />
                                        <div class="modal-header border-0">
                                            <h5 class="modal-title fw-bold"><i class='bx bx-flag'></i> Report @m.KnownAs</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Reason</label>
                                                <select name="reason" class="form-select" required>
                                                    <option value="">Select a reason...</option>
                                                    <option value="Spam">Spam</option>
                                                    <option value="InappropriateContent">Inappropriate Content</option>
                                                    <option value="FakeProfile">Fake Profile</option>
                                                    <option value="Harassment">Harassment</option>
                                                    <option value="Underage">Underage</option>
                                                    <option value="Scam">Scam</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Details (optional)</label>
                                                <textarea name="description" class="form-control" rows="3" maxlength="2000"
                                                          placeholder="Provide any additional details..."></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0">
                                            <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning rounded-pill">
                                                <i class='bx bx-flag'></i> Submit Report
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(m.Introduction))
                        {
                            <hr />
                            <div class="text-start">
                                <h6 class="fw-bold">About @m.KnownAs</h6>
                                <p class="text-muted small">@m.Introduction</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(m.LookingFor))
                        {
                            <div class="text-start mt-2">
                                <h6 class="fw-bold">Looking For</h6>
                                <p class="text-muted small">@m.LookingFor</p>
                            </div>
                        }

                        @if (m.InterestTags.Count > 0)
                        {
                            <div class="text-start mt-2">
                                <h6 class="fw-bold">Interests</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var tag in m.InterestTags)
                                    {
                                        var color = categoryColors.ContainsKey(tag.Category) ? categoryColors[tag.Category] : "secondary";
                                        <span class="badge bg-@color bg-opacity-10 text-@color">@tag.Name</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(m.Interests))
                        {
                            <div class="text-start mt-2">
                                <h6 class="fw-bold">Interests</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var interest in m.Interests.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="badge bg-light text-dark">@interest</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Photo Gallery -->
            <div class="col-md-8">
                <h4 class="fw-bold mb-3"><i class='bx bx-images'></i> Gallery</h4>
                @if (Model.Photos.Any())
                {
                    <div class="row g-3">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="col-md-4">
                                <div class="card border-0 rounded-4 overflow-hidden shadow-sm h-100">
                                    <div class="position-relative" style="height:250px;">
                                        <img src="@photo.PhotoUrl" class="w-100 h-100" style="object-fit:cover;"
                                             onerror="this.onerror=null;this.src='/images/default-user.png';"
                                             alt="Photo">
                                        @if (photo.IsMain)
                                        {
                                            <span class="position-absolute top-0 start-0 m-2 badge bg-primary">Main</span>
                                        }
                                        <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75">
                                            @switch (photo.PrivacyLevel)
                                            {
                                                case MvcApp.Core.PrivacyLevel.Public:
                                                    <text><i class='bx bx-globe'></i> Public</text>
                                                    break;
                                                case MvcApp.Core.PrivacyLevel.MembersOnly:
                                                    <text><i class='bx bx-group'></i> Members</text>
                                                    break;
                                                case MvcApp.Core.PrivacyLevel.ExplicitUnlocked:
                                                    <text><i class='bx bx-lock-open'></i> Explicit</text>
                                                    break;
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class='bx bx-image' style="font-size:4rem; color:#ccc;"></i>
                        <p class="text-muted mt-2">No photos available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
