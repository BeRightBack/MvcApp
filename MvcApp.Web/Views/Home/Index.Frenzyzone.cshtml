@inject MvcApp.Core.Abstractions.IModuleManager ModuleManager
@{
    ViewData["Title"] = "Frenzyzone";
    ViewData["Description"] = "Frenzyzone is a business portal: services, publishing, a storefront and a support forum, all manageable without a deploy.";
    ViewData["Keywords"] = "business portal, services, publishing, storefront, forum";

    // Every section below links into a module. A portal with Store switched off must not
    // advertise a storefront that 404s, so each link is gated the way NavService gates the
    // navbar. The area list in the hero is composed from the enabled set too, so the sentence
    // cannot promise something the page does not have.
    var pagesOn = await ModuleManager.IsModuleEnabledAsync("Pages");
    var blogOn = await ModuleManager.IsModuleEnabledAsync("Blog");
    var storeOn = await ModuleManager.IsModuleEnabledAsync("Store");
    var forumOn = await ModuleManager.IsModuleEnabledAsync("Forum");
}

<section class="fz-hero">
    <div class="container">
        <span class="fz-eyebrow">@Localizer["Business Portal"]</span>
        <h1>@Localizer["Ship it once. Then run it yourself."]</h1>
        @* The lead must not advertise a module that is switched off, so the areas are composed
           from the enabled set rather than written as one fixed claim. The conjunction is
           localized too: a hardcoded " and " renders English inside an otherwise French sentence.
           Format arguments are ignored by DbStringLocalizer, so the value is substituted by hand.
           Keys are whole words, never ", " / " and ", because StringResources is PAD SPACE and a
           key with a leading space can never be found. *@
        <p class="lead">
            @{
                var areas = new List<string>();
                if (pagesOn) { areas.Add(Localizer["services"].Value); }
                if (blogOn) { areas.Add(Localizer["writing"].Value); }
                if (storeOn) { areas.Add(Localizer["a storefront"].Value); }
                var conj = " " + Localizer["and"].Value + " ";
                var areaText = areas.Count switch
                {
                    0 => "",
                    1 => areas[0],
                    2 => areas[0] + conj + areas[1],
                    _ => string.Join(", ", areas.Take(areas.Count - 1)) + conj + areas[^1],
                };
                var leadTemplate = Localizer["{0}— one portal you can actually run."].Value;
            }
            @(string.IsNullOrEmpty(areaText)
                ? Localizer["One portal you can actually run."].Value
                : leadTemplate.Replace("{0}", areaText + " "))
        </p>
        <div class="fz-hero-actions">
            <a class="fz-btn-primary" asp-controller="Home" asp-action="Contact">@Localizer["Start a conversation"]</a>
            @if (pagesOn)
            {
                <a class="fz-btn-ghost" asp-controller="Pages" asp-action="Index">@Localizer["See what's on offer"]</a>
            }
        </div>
    </div>
</section>

<section class="fz-section">
    <div class="container">
        <div class="fz-section-head">
            <h2>@Localizer["What you get"]</h2>
            <p>@Localizer["Four working areas. Each one is a real part of the site, not a placeholder."]</p>
        </div>
        <div class="row g-4">
            @if (pagesOn)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="fz-card">
                        <span class="fz-icon"><i class="bx bx-file"></i></span>
                        <h3>@Localizer["Services"]</h3>
                        <p>@Localizer["Structured pages, so what you do is always one click away and never buried in a paragraph."]</p>
                    </div>
                </div>
            }
            @if (blogOn)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="fz-card">
                        <span class="fz-icon"><i class="bx bx-terminal"></i></span>
                        <h3>@Localizer["Writing"]</h3>
                        <p>@Localizer["A blog with categories and tags for changelogs, guides, and the reasoning behind decisions."]</p>
                    </div>
                </div>
            }
            @if (storeOn)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="fz-card">
                        <span class="fz-icon"><i class="bx bx-cart"></i></span>
                        <h3>@Localizer["Storefront"]</h3>
                        <p>@Localizer["Products, categories, a cart and checkout. You supply the catalogue; the portal handles the rest."]</p>
                    </div>
                </div>
            }
            <div class="col-md-6 col-xl-3">
                <div class="fz-card">
                    <span class="fz-icon"><i class="bx bx-send"></i></span>
                    <h3>@Localizer["Direct contact"]</h3>
                    <p>@Localizer["A form that reaches your inbox, and a way to reach a person rather than a queue."]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="fz-section fz-section-alt">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <div class="fz-section-head mb-lg-0">
                    <h2>@Localizer["How it works"]</h2>
                    <p>@Localizer["No discovery phase. Same four steps every time, whether it is a landing page or a full build."]</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="fz-step">
                    <span class="fz-step-num">1</span>
                    <div>
                        <h3>@Localizer["You describe the outcome"]</h3>
                        <p>@Localizer["Not a list of deliverables. The result you need, and the date it has to exist by."]</p>
                    </div>
                </div>
                <div class="fz-step">
                    <span class="fz-step-num">2</span>
                    <div>
                        <h3>@Localizer["You get the scope in writing"]</h3>
                        <p>@Localizer["What is included, what is explicitly not, and what it costs. All of it before anything starts."]</p>
                    </div>
                </div>
                <div class="fz-step">
                    <span class="fz-step-num">3</span>
                    <div>
                        <h3>@Localizer["You watch it happen"]</h3>
                        <p>@Localizer["Progress lives here, in the open, rather than in an inbox nobody has read since March."]</p>
                    </div>
                </div>
                <div class="fz-step">
                    <span class="fz-step-num">4</span>
                    <div>
                        <h3>@Localizer["You own the result"]</h3>
                        <p>@Localizer["Everything built for you stays yours, documented, and portable if you ever want to take it elsewhere."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="fz-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <div class="fz-section-head">
                    <h2>@Localizer["Built to be handed over"]</h2>
                    <p>@Localizer["Most of the value of a site is what happens on the days nobody is looking at it. Content, catalogue and navigation are all manageable without a developer in the room."]</p>
                </div>
                <ul class="fz-link-list">
                    @if (blogOn)
                    {
                        <li>
                            <a asp-controller="Blog" asp-action="Index">
                                <span>@Localizer["Read the blog"]</span>
                                <i class="bx bx-right-arrow-alt"></i>
                            </a>
                        </li>
                    }
                    @if (pagesOn)
                    {
                        <li>
                            <a asp-controller="Pages" asp-action="Index">
                                <span>@Localizer["Browse the company pages"]</span>
                                <i class="bx bx-right-arrow-alt"></i>
                            </a>
                        </li>
                    }
                    @if (storeOn)
                    {
                        <li>
                            <a asp-controller="Store" asp-action="Index">
                                <span>@Localizer["Visit the storefront"]</span>
                                <i class="bx bx-right-arrow-alt"></i>
                            </a>
                        </li>
                    }
                    @if (forumOn)
                    {
                        <li>
                            <a asp-controller="Forum" asp-action="Index">
                                <span>@Localizer["Ask a question in the forum"]</span>
                                <i class="bx bx-right-arrow-alt"></i>
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Home" asp-action="Contact">
                            <span>@Localizer["Send a message"]</span>
                            <i class="bx bx-right-arrow-alt"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="fz-card">
                    <span class="fz-icon"><i class="bx bx-code-block"></i></span>
                    <h3>@Localizer["Roles, not shared logins"]</h3>
                    <p>@Localizer["Accounts and roles are built in, so the people who need to publish and the people who need to read are not sharing one."]</p>
                    <p class="mt-3">@Localizer["And if you would rather not manage any of it, that is a perfectly reasonable way to use this too."]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="fz-section pt-0">
    <div class="container">
        <div class="fz-cta">
            <h2>@Localizer["Got something in mind?"]</h2>
            <p>@Localizer["Two sentences is plenty. If it is something we can do well, you will get a straight answer about scope and cost."]</p>
            <a class="fz-btn-primary" asp-controller="Home" asp-action="Contact">@Localizer["Get in touch"]</a>
        </div>
    </div>
</section>
