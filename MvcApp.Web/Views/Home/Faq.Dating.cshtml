@{
    ViewData["Title"] = "FAQ";
    Layout = "_Layout";
}
<section class="py-4">
    <div class="container">
        <h1 class="fw-bold mb-4" style="font-family:'Playfair Display',Georgia,serif;">Dating FAQ</h1>
        <div class="accordion" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh1">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc1">
                        How does matching work?
                    </button>
                </h2>
                <div id="dc1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Our algorithm suggests profiles based on your preferences (age, location, gender). You can browse freely using Discover and send a Like to anyone who catches your interest.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc2">
                        What is a "Like" and how is it different from a "Match"?
                    </button>
                </h2>
                <div id="dc2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">A Like means you're interested in someone. If they Like you back, it's a Match! You'll both be notified and can start a conversation.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh3">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc3">
                        Can I change who sees my profile?
                    </button>
                </h2>
                <div id="dc3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Yes. You can set your preferred gender, age range, and location filters in your Discover settings to control who appears in your feed and who can find you.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh4">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc4">
                        How do I stay safe while dating online?
                    </button>
                </h2>
                <div id="dc4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Never share financial information, meet in public places for first dates, and report any suspicious behavior using our Report button. Your safety is our priority.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh5">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc5">
                        What does the "Appreciation" rating mean?
                    </button>
                </h2>
                <div id="dc5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">You can give a 1–5 star rating to any member's profile. It's a way to show appreciation and help others know how genuine a person is. Ratings are anonymous and averaged.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="dh6">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dc6">
                        How do I start a conversation?
                    </button>
                </h2>
                <div id="dc6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Once you've matched (you both liked each other), you can send a message from the Messages section. Say something genuine and personal to break the ice!</div>
                </div>
            </div>
        </div>
    </div>
</section>
