@using MvcApp.Web.Models.LikesViewModels
@model List<MemberCardViewModel>
@{
    ViewData["Title"] = "Matches";
    ViewData["ReturnUrl"] = "/Matches";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="fw-bold" style="font-family:'Playfair Display',Georgia,serif;">Your Matches</h1>
                <p class="text-muted">People who like you back</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn rounded-pill btn-outline-secondary" href="/Likes?predicate=liked">
                    <i class='bx bxs-heart'></i> People I Like
                </a>
                <a class="btn rounded-pill btn-outline-secondary" href="/Likes?predicate=likedby">
                    <i class='bx bx-heart'></i> Who Likes Me
                </a>
                <a class="btn rounded-pill btn-outline-secondary" href="/Discover">
                    <i class='bx bx-compass'></i> Discover
                </a>
                <a class="btn rounded-pill btn-outline-secondary" href="/Likes/Blocked">
                    <i class='bx bx-block'></i> Blocked Users
                </a>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var card in Model)
                {
                    @await Html.PartialAsync("_MemberCard", card, new ViewDataDictionary(ViewData))
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="match-badge d-inline-flex align-items-center mb-3">
                    <i class='bx bxs-heart me-1'></i> No matches yet
                </div>
                <h4 class="mt-3">Keep liking to find your match</h4>
                <p class="text-muted">When someone you like likes you back, you'll both be notified.</p>
                <a class="btn rounded-pill btn-primary" href="/Discover">
                    <i class='bx bx-compass'></i> Browse Discover
                </a>
            </div>
        }
    </div>
</section>
