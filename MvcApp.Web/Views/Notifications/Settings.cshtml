@model MvcApp.Web.Models.NotificationsViewModels.NotificationSettingsViewModel
@{
    ViewData["Title"] = "Notification Settings";
}
<section class="py-4">
    <div class="container">
        <div class="card border-0 rounded-4 shadow-sm mx-auto" style="max-width:560px;">
            <div class="card-header d-flex justify-content-between align-items-center bg-transparent border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0">
                    <i class='bx bxs-bell-ring'></i> Notification Settings
                </h4>
                <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class='bx bx-arrow-back'></i> Back
                </a>
            </div>
            <div class="card-body px-4 pb-4">
                @if (TempData["NotificationSettingsSaved"] is bool saved && saved)
                {
                    <div class="alert alert-success py-2 small">Your notification settings have been saved.</div>
                }
                <form method="post" asp-controller="Notifications" asp-action="Settings">
                    @Html.AntiForgeryToken()
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="emailOnLike" name="EmailOnLike" value="true" @(Model.EmailOnLike ? "checked" : "")>
                        <label class="form-check-label" for="emailOnLike">
                            <strong>Email me when someone likes me</strong>
                            <div class="text-muted small">Get an email when a member likes your profile.</div>
                        </label>
                    </div>
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="emailOnMatch" name="EmailOnMatch" value="true" @(Model.EmailOnMatch ? "checked" : "")>
                        <label class="form-check-label" for="emailOnMatch">
                            <strong>Email me when I get a match</strong>
                            <div class="text-muted small">Get an email when you and a member like each other.</div>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill">
                        <i class='bx bx-check'></i> Save Settings
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
