@using MvcApp.Core
@using MvcApp.Infrastructure.Extentions
@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<section class="py-4">
    <div class="container">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center bg-transparent border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0">
                    <i class='bx bx-bell'></i> Notifications
                    @if (Model.Any(n => !n.IsRead))
                    {
                        <span class="badge rounded-pill bg-danger ms-1">@Model.Count(n => !n.IsRead) new</span>
                    }
                </h4>
                <div class="d-flex gap-2">
                    <a asp-controller="Notifications" asp-action="Settings" class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class='bx bx-cog'></i> Settings
                    </a>
                    @if (Model.Any(n => !n.IsRead))
                    {
                        <form method="post" asp-controller="Notifications" asp-action="MarkAllRead">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">
                                <i class='bx bx-check-double'></i> Mark all as read
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class='bx bxs-heart' style="font-size:3rem; color:#e74c6f;"></i>
                        <h5 class="mt-3">No notifications yet</h5>
                        <p class="text-muted">When someone likes you or you match, you'll see it here.</p>
                        <a class="btn rounded-pill btn-primary" href="/Discover">
                            <i class='bx bx-compass'></i> Browse Discover
                        </a>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            var icon = n.Type.Equals("Match", StringComparison.OrdinalIgnoreCase)
                                ? "<i class='bx bxs-heart'></i>"
                                : "<i class='bx bx-heart'></i>";
                            <a href="@(string.IsNullOrWhiteSpace(n.Url) ? "#" : n.Url)"
                               class="list-group-item list-group-item-action d-flex align-items-start gap-3 p-3 @(n.IsRead ? "" : "bg-light")">
                                <span class="fs-4 @(n.Type.Equals("Match", StringComparison.OrdinalIgnoreCase) ? "text-danger" : "text-primary")">
                                    @Html.Raw(icon)
                                </span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold @(n.IsRead ? "" : "text-danger")">@n.Message</div>
                                    <small class="text-muted d-block">@n.CreatedAt.TimeAgo()</small>
                                </div>
                                @if (!n.IsRead)
                                {
                                    <span class="badge rounded-pill bg-danger mt-1">new</span>
                                }
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
