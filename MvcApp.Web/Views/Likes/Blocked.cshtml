@using MvcApp.Web.Models.LikesViewModels
@model List<MemberCardViewModel>
@{
    ViewData["Title"] = "Blocked Users";
    ViewData["ReturnUrl"] = "/Likes/Blocked";
}
<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="fw-bold" style="font-family:'Playfair Display',Georgia,serif;">Blocked Users</h1>
                <p class="text-muted">Blocked members can't see your profile, like you, or message you.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn rounded-pill btn-outline-secondary" href="/Likes?predicate=liked">
                    <i class='bx bxs-heart'></i> Likes
                </a>
                <a class="btn rounded-pill btn-outline-secondary" href="/Matches">
                    <i class='bx bxs-heart'></i> Matches
                </a>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var card in Model)
                {
                    @await Html.PartialAsync("_MemberCard", card, new ViewDataDictionary(ViewData))
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class='bx bx-user-check' style="font-size:3rem; color:#e74c6f;"></i>
                <h4 class="mt-3">No blocked users</h4>
                <p class="text-muted">Members you block will show up here so you can unblock them later.</p>
            </div>
        }
    </div>
</section>
