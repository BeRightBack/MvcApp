@model MvcApp.Core.SystemSetting
@{
    ViewData["Title"] = "Add Setting";
}

<div class="page-header">
    <h1>Add Setting</h1>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="content-card">
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Key" class="form-label small fw-semibold"></label>
                        <input asp-for="Key" class="form-control" required list="suggestedKeys" />
                        @{
                            var keys = new[] { "SiteUnderMaintenance", "DefaultLanguage", "MaxLoginAttempts", "LockoutDurationMinutes", "MaxUserRegistration", "SmtpEnabled", "EnableRegistration", "SessionTimeoutMinutes", "PendingDeletionDays", "VisitorTrackingEnabled" };
                        }
                        <datalist id="suggestedKeys">
                            @foreach (var k in keys) { @Html.Raw("<option value=\"" + k + "\">"); }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Value" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Value" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold"></label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Group" class="form-label small fw-semibold"></label>
                        <input asp-for="Group" class="form-control" placeholder="General" list="suggestedGroups" />
                        @{ var groups = new[] { "General", "Security", "Features", "Registration", "Maintenance" }; }
                        <datalist id="suggestedGroups">
                            @foreach (var g in groups) { @Html.Raw("<option value=\"" + g + "\">"); }
                        </datalist>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="content-card">
            <div class="card-header">Suggested Settings</div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless mb-0">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Type</th>
                            <th>Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td><code>SiteUnderMaintenance</code></td><td>bool</td><td><code>false</code></td></tr>
                        <tr><td><code>DefaultLanguage</code></td><td>string</td><td><code>en</code></td></tr>
                        <tr><td><code>MaxLoginAttempts</code></td><td>int</td><td><code>5</code></td></tr>
                        <tr><td><code>LockoutDurationMinutes</code></td><td>int</td><td><code>15</code></td></tr>
                        <tr><td><code>MaxUserRegistration</code></td><td>int</td><td><code>1000</code></td></tr>
                        <tr><td><code>SmtpEnabled</code></td><td>bool</td><td><code>true</code></td></tr>
                        <tr><td><code>EnableRegistration</code></td><td>bool</td><td><code>true</code></td></tr>
                        <tr><td><code>SessionTimeoutMinutes</code></td><td>int</td><td><code>20</code></td></tr>
                        <tr><td><code>PendingDeletionDays</code></td><td>int</td><td><code>30</code></td></tr>
                        <tr><td><code>VisitorTrackingEnabled</code></td><td>bool</td><td><code>true</code></td></tr>
                    </tbody>
                </table>
                <p class="small text-muted mt-2 mb-0">
                    <i class='bx bx-info-circle'></i>
                    These are suggestions — your app code must check <code>ISettingsService</code> to read them. Add any key/value pairs your features need.
                </p>
            </div>
        </div>
    </div>
</div>
