@model MvcApp.Core.SystemSetting
@{
    ViewData["Title"] = "Edit Setting";
}

<div class="page-header">
    <h1>Edit Setting</h1>
</div>

<div class="content-card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Key" class="form-label small fw-semibold"></label>
                <input asp-for="Key" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Value" class="form-label small fw-semibold"></label>
                <textarea asp-for="Value" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label small fw-semibold"></label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Group" class="form-label small fw-semibold"></label>
                <input asp-for="Group" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
