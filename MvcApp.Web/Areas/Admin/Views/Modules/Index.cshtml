@model List<MvcApp.Core.Abstractions.ModuleInfo>
@{
    ViewData["Title"] = "Modules";
}

<div class="page-header">
    <h1>@Localizer["Modules"]</h1>
    <p class="text-muted">@Localizer["Enable or disable application features. Disabled modules are hidden from navigation and return 404."]</p>
</div>

<div class="content-card">
    <div class="card-body p-0">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>@Localizer["Module"]</th>
                    <th>@Localizer["Description"]</th>
                    <th>@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var module in Model)
                {
                    <tr>
                        <td><strong>@module.DisplayName</strong></td>
                        <td class="text-muted">@module.Description</td>
                        <td>
                            @if (module.IsEnabled)
                            {
                                <span class="badge bg-success">@Localizer["Enabled"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="name" value="@module.Name" />
                                <input type="hidden" name="enabled" value="@(module.IsEnabled ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm @(module.IsEnabled ? "btn-outline-danger" : "btn-outline-success") btn-admin">
                                    @(module.IsEnabled ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>