@using MvcApp.Web.Areas.Admin.Models.UserViewModels
@model IEnumerable<RoleWithUsersViewModel>

@{
    ViewData["Title"] = "Roles";
}

<div class="bg-primary m-1 p-1"><h4>Roles</h4></div>

<div class="text-danger" asp-validation-summary="ModelOnly"></div>

<table class="table table-sm table-bordered table-bordered">
    <tr><th>Name</th><th>Description</th><th>Users</th><th></th></tr>
    @if (Model.Count() == 0) {
        <tr><td colspan="4" class="text-center">No Roles</td></tr>
    } else {
        foreach (var roleWithUsers in Model) {
            <tr>                
                <td>@roleWithUsers.Role.Name</td>
                <td>@roleWithUsers.Role.Description</td>
                <td>
                    @foreach (var user in roleWithUsers.Users)
                    {
                        <span>@user.UserName</span><br />
                    }
                </td>
                <td>
                    <form asp-action="Delete" asp-route-id="@roleWithUsers.Role.Id" method="post">
                        <a class="btn btn-sm btn-primary" asp-action="Edit"
                           asp-route-id="@roleWithUsers.Role.Id">Edit</a>
                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    }
</table>
<a class="btn btn-primary" asp-action="Create">Create</a>
