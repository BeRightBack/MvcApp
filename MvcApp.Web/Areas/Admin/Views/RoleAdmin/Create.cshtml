@using MvcApp.Web.Areas.Admin.Models.UserViewModels
@model RoleViewModel

@{
    ViewData["Title"] = "Roles";
}

<div class="bg-primary m-1 p-1"><h4>Create Role</h4></div>

<div asp-validation-summary="All" class="text-danger"></div>
<div class="row">
    <div class="col-md-4">
        <form method="get" asp-action="Create">
            <div class="form-group">
                <input type="text" name="searchQuery" value="@ViewData["SearchQuery"]" class="form-control" placeholder="Search users..." />
                <button type="submit" class="btn btn-primary mt-2">Search</button>
            </div>
        </form>
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <h6 class="bg-info p-1 text-white">Add Users to Role</h6>
            <table class="table table-bordered table-sm">
                @if (Model.NonMembers.Count() == 0)
                {
                    <tr><td colspan="2">No Users Available</td></tr>
                }
                else
                {
                    @foreach (UserProfile user in Model.NonMembers)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>
                                <input type="checkbox" name="IdsToAdd" value="@user.Id">
                            </td>
                        </tr>
                    }
                }
            </table>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @for (int i = 1; i <= (int)ViewData["TotalPages"]!; i++)
                {
                    <li class="page-item @(i == (int)ViewData["PageNumber"]! ? "active" : "")">
                        <a class="page-link" asp-action="Create" asp-route-pageNumber="@i" asp-route-searchQuery="@ViewData["SearchQuery"]">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
