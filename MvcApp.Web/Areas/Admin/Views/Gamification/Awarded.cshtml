@model List<MvcApp.Core.UserBadge>
@{
    ViewData["Title"] = "Awarded Badges";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Awarded Badges</h4>
        <small class="text-muted">All badge awards across the platform</small>
    </div>
    <a asp-action="Badges" class="btn btn-outline-secondary btn-sm">
        <i class='bx bx-arrow-back me-1'></i>Back
    </a>
</div>

<div class="content-card">
    <div class="card-body p-0">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Badge</th>
                    <th>Category</th>
                    <th class="text-end">Awarded</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ub in Model)
                {
                    <tr>
                        <td>@(ub.User?.KnownAs ?? ub.User?.UserName ?? "Unknown")</td>
                        <td>
                            <i class='@ub.Badge?.Icon me-1' style="color:var(--primary);"></i>
                            @ub.Badge?.Name
                        </td>
                        <td><span class="badge bg-secondary">@ub.Badge?.Category</span></td>
                        <td class="text-end text-muted small">@ub.EarnedAt.ToString("MMM dd, yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Awarded" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
