@model IEnumerable<MvcApp.Core.VerificationRequest>
@using MvcApp.Core
@{
    ViewData["Title"] = "Verification Moderation";
    var filter = ViewBag.Filter as string ?? "pending";
    var pendingCount = (int)ViewBag.PendingCount;
}

<section class="py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold"><i class='bx bx-check-shield'></i> Verification Moderation</h2>
                <p class="text-muted mb-0">
                    @if (pendingCount > 0)
                    {
                        <span class="badge bg-danger me-2">@pendingCount pending</span>
                    }
                    Review user verification requests
                </p>
            </div>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="mb-3">
            @{
                var pendingClass = filter == "pending" ? "btn-danger" : "btn-outline-danger";
                var approvedClass = filter == "approved" ? "btn-success" : "btn-outline-success";
                var rejectedClass = filter == "rejected" ? "btn-secondary" : "btn-outline-secondary";
            }
            <div class="btn-group">
                <a asp-action="Index" asp-route-filter="pending" class="btn @pendingClass">
                    Pending <span class="badge bg-white text-danger ms-1">@pendingCount</span>
                </a>
                <a asp-action="Index" asp-route-filter="approved" class="btn @approvedClass">Approved</a>
                <a asp-action="Index" asp-route-filter="rejected" class="btn @rejectedClass">Rejected</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class='bx bx-check-circle' style="font-size:4rem; color:#27ae60;"></i>
                <h4 class="mt-3">All clear!</h4>
                <p class="text-muted">No verification requests to review.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var request in Model)
                {
                    <div class="col-md-4">
                        <div class="card border-0 rounded-4 shadow-sm h-100">
                            <div class="position-relative bg-light" style="height:250px;">
                                <img src="/Verifications/@request.User?.UserName/@request.Filename"
                                     class="w-100 h-100" style="object-fit:cover; border-radius:1rem 1rem 0 0;"
                                     onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'d-flex align-items-center justify-content-center h-100 text-muted\'><i class=\'bx bx-image\' style=\'font-size:3rem;\'></i></div>';"
                                     alt="Verification photo">
                                <span class="position-absolute top-0 end-0 m-2 badge @(request.Status == VerificationStatus.Pending ? "bg-warning text-dark" : request.Status == VerificationStatus.Approved ? "bg-success" : "bg-danger")">
                                    @request.Status
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <strong>@request.User?.KnownAs</strong>
                                        <small class="text-muted d-block">@@@request.User?.UserName</small>
                                    </div>
                                    <small class="text-muted">@request.RequestedAt.ToString("MMM d, h:mm tt")</small>
                                </div>
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark">Number in photo: <strong>@request.DisplayNumber</strong></span>
                                </div>
                                @if (!string.IsNullOrEmpty(request.AdminNotes))
                                {
                                    <div class="text-muted small mb-2">Notes: @request.AdminNotes</div>
                                }
                                @if (request.Status == VerificationStatus.Pending)
                                {
                                    <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="notes" value="Approved" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill">
                                            <i class='bx bx-check'></i> Approve
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"
                                            onclick="document.getElementById('rejectForm_@request.Id').style.display='block'">
                                        <i class='bx bx-x'></i> Reject
                                    </button>
                                    <div id="rejectForm_@request.Id" style="display:none;" class="mt-2">
                                        <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="text" name="notes" class="form-control form-control-sm mb-1" placeholder="Rejection reason (optional)" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill">Confirm Reject</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-filter="@filter">Previous</a>
                            </li>
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-filter="@filter">@i</a>
                                </li>
                            }
                            <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-filter="@filter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</section>
