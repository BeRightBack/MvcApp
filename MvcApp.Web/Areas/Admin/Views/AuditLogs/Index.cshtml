@model List<MvcApp.Core.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>@Localizer["Audit Logs"]</h1>
</div>

<div class="content-card">
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group" style="max-width:400px">
                <input type="text" name="search" class="form-control" placeholder="@(Localizer["Search logs..."])" value="@ViewBag.Search" />
                <button class="btn btn-outline-secondary" type="submit"><i class='bx bx-search'></i></button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-admin">
                <thead>
                    <tr>
                        <th>@Localizer["Time"]</th>
                        <th>@Localizer["User"]</th>
                        <th>@Localizer["Action"]</th>
                        <th>@Localizer["Entity"]</th>
                        <th>@Localizer["Details"]</th>
                        <th>@Localizer["IP"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap small">@log.Timestamp.ToString("MMM dd HH:mm")</td>
                            <td>@log.UserName</td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@log.Action</span></td>
                            <td>@log.Entity @log.EntityId</td>
                            <td class="small text-muted" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@log.Details</td>
                            <td class="small text-muted">@log.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav>
            <ul class="pagination pagination-sm justify-content-center mt-3">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                        @* asp-action/asp-route, not a hand-written href="?search=..&page=..".
                           A bare query-only href resolves against whatever path the browser
                           currently has, so it silently lands on the front page as soon as the
                           area path is not exactly as assumed. The tag helper builds the absolute
                           /Admin/AuditLogs?… URL and URL-encodes the search term, which a raw
                           href does not. Same pattern as SystemLogs and VerificationModeration. *@
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search"
                           asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
