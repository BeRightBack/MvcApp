@model List<LocalizationViewModel>
@{
    ViewData["Title"] = "Index";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h5>@Localizer["Translation coverage"]</h5>
        <p class="mb-2">
            @* DbStringLocalizer ignores format arguments, so placeholders are substituted here. *@
            @* LanguageCount is the number of TARGET languages: no row is stored for the source
               language, so counting it would report every key as incomplete. *@
            @string.Format(Localizer["{0} key(s) across {1} target language(s)."], ViewBag.KeyCount, ViewBag.LanguageCount)
            @if ((int)ViewBag.MissingCount > 0)
            {
                <strong class="text-warning">&#183; @string.Format(Localizer["{0} still need a translation."], ViewBag.MissingCount)</strong>
            }
            else
            {
                <span class="text-success">&#183; @Localizer["Every language is covered."]</span>
            }
        </p>
        @if ((int)ViewBag.MissingCount > 0)
        {
            <form asp-controller="Localization" asp-action="TranslateMissing" method="post" class="d-inline"
                data-confirm="@Localizer["Queue the missing translations for background translation?"]"
                onsubmit="return confirm(this.dataset.confirm);">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bx bx-globe"></i> @Localizer["Translate missing keys"]
                </button>
                <span class="form-text">@Localizer["Runs in the background, paced against the DeepL rate limit. The page stays usable while it works."]</span>
            </form>
        }
    </div>
</div>

<a asp-controller="Localization" asp-action="Create" class="btn btn-primary">@Localizer["Create"]</a>
<form asp-controller="Localization" asp-action="Index" asp-route-page="1" asp-route-pageSize=@ViewBag.PageSize&
    asp-route-searchString=@ViewBag.SearchString method="get" class="form-inline" role="form">
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">@Localizer["Search:"]</label>
        <div class="col-sm-10">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label">@Localizer["Page Size:"]</label>
        <div class="col-sm-10">
            <input type="number" name="pageSize" min="1" max="@ViewBag.TotalCount" value="@ViewBag.PageSize"
                class="form-control" />
        </div>
    </div>
    <div class="text-right">
        <button type="submit" class="btn btn-primary">@Localizer["Search"]</button>
        <a href="@Url.Action("Index", "Localization")" class="btn btn-secondary">@Localizer["Clear Search"]</a>
    </div>
</form>

<div class="row">
    <div class="col-md-12">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Value"]</th>
                    <th>@Localizer["Language"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var resource in Model)
                    {
                        <tr>
                            <td>@resource.Id</td>
                            <td>@resource.Name</td>
                            <td>@resource.Value</td>
                            <td>@resource.LanguageName</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@resource.Id">@Localizer["Edit"]</a> |
                                <a asp-action="Details" asp-route-id="@resource.Id">@Localizer["Details"]</a> |
                                <a asp-action="Delete" asp-route-id="@resource.Id">@Localizer["Delete"]</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">@Localizer["No results found."]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-12">
        <nav aria-label="@(Localizer["Page navigation example"])">
            <ul class="pagination justify-content-center">
                @if (ViewBag.Page > 1)
                {
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page=@(ViewBag.Page - 1) asp-route-pageSize=@ViewBag.PageSize&
                            asp-route-searchString=@ViewBag.SearchString class="page-link" aria-label="@(Localizer["Previous"])">
                            <span aria-hidden="true">&laquo;</span>
                            <span class="sr-only">@Localizer["Previous"]</span>
                        </a>
                    </li>
                }

                @* Display first page and ellipsis if needed *@
                @if (ViewBag.Page > 3)
                {
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page="1" asp-route-pageSize=@ViewBag.PageSize&
                            asp-route-searchString=@ViewBag.SearchString class="page-link">1</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                @* Display page numbers around the current page *@
                @for (int i = Math.Max(1, ViewBag.Page - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.Page + 2); i++)
                {
                    if (i == ViewBag.Page)
                    {
                        <li class="page-item active">
                            <span class="page-link">@i <span class="sr-only">(current)</span></span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a asp-action="Index" asp-route-page=@i asp-route-pageSize=@ViewBag.PageSize&
                                asp-route-searchString=@ViewBag.SearchString class="page-link">@i</a>
                        </li>
                    }
                }

                @* Display ellipsis and last page if needed *@
                @if (ViewBag.Page < ViewBag.TotalPages - 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page=@ViewBag.TotalPages asp-route-pageSize=@ViewBag.PageSize&
                            asp-route-searchString=@ViewBag.SearchString class="page-link">@ViewBag.TotalPages</a>
                    </li>
                }

                @if (ViewBag.Page < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a asp-action="Index" asp-route-page=@(ViewBag.Page + 1) asp-route-pageSize=@ViewBag.PageSize&
                            asp-route-searchString=@ViewBag.SearchString class="page-link" aria-label="@(Localizer["Next"])">
                            <span aria-hidden="true">&raquo;</span>
                            <span class="sr-only">@Localizer["Next"]</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

