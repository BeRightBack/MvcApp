@model MvcApp.Core.InterestTag
@{
    ViewData["Title"] = "Create Interest Tag";
    var categories = (MvcApp.Core.InterestCategory[])ViewBag.Categories;
    var categoryColors = new Dictionary<MvcApp.Core.InterestCategory, string> {
        { MvcApp.Core.InterestCategory.Interest, "primary" },
        { MvcApp.Core.InterestCategory.Fantasy, "danger" },
        { MvcApp.Core.InterestCategory.Hobby, "success" },
        { MvcApp.Core.InterestCategory.Lifestyle, "info" },
        { MvcApp.Core.InterestCategory.Kink, "warning" }
    };
}

<section class="py-4">
    <div class="container" style="max-width:600px;">
        <h2 class="fw-bold mb-4"><i class='bx bx-plus-circle'></i> Create Interest Tag</h2>

        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tag Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Hiking, BDSM, Vegan..." autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Category" class="form-label fw-semibold">Category</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cat in categories)
                            {
                                var color = categoryColors.ContainsKey(cat) ? categoryColors[cat] : "secondary";
                                var isChecked = Model.Category == cat;
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Category" value="@((int)cat)"
                                           id="cat_@((int)cat)" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label badge bg-@color bg-opacity-10 text-@color" for="cat_@((int)cat)" style="cursor:pointer;">
                                        @cat
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class='bx bx-check'></i> Create Tag
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
