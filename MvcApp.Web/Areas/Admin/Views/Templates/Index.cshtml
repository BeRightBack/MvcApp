@using MvcApp.Core.Abstractions
@model List<UiTemplateInfo>
@{
    ViewData["Title"] = "UI Templates";
    var active = ViewBag.ActiveTemplate as string;
    var landingEnabled = ViewBag.LandingEnabled as Dictionary<string, bool>;
}

<h1 class="mb-4">UI Templates</h1>
<p class="text-muted">Choose how your site looks. Templates change colors, fonts, and visual style. A landing page advertises the template's purpose; when disabled, the site shows the generic home page.</p>

<div class="row g-4">
    @foreach (var template in Model)
    {
        var isActive = string.Equals(template.Name, active, StringComparison.OrdinalIgnoreCase);
        var landing = landingEnabled != null && landingEnabled.TryGetValue(template.Name, out var l) && l;
        <div class="col-md-6 col-lg-4">
            <div class="card @(isActive ? "border-primary" : "")">
                <div class="card-body text-center p-4">
                    @if (isActive)
                    {
                        <span class="badge bg-success mb-2">Active</span>
                    }
                    <h5 class="card-title">@template.DisplayName</h5>
                    <p class="card-text text-muted small">@template.Description</p>
                    <div class="border rounded overflow-hidden mb-3 position-relative" style="height:120px; background:var(--template-bg-alt, #f8f9fc)">
                        <img src="@template.Thumbnail" alt="@template.DisplayName" class="w-100 h-100" style="object-fit:cover;"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <span class="w-100 h-100 align-items-center justify-content-center" style="font-size:2.5rem; display:none;">&#x1F3A8;</span>
                    </div>
                    @if (!isActive)
                    {
                        <form asp-action="SetActive" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="name" value="@template.Name" />
                            <button type="submit" class="btn btn-primary">Activate</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-success" disabled>Active</button>
                    }
                    <form asp-action="SetLanding" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="name" value="@template.Name" />
                        <input type="hidden" name="enabled" value="@(landing ? "false" : "true")" />
                        <button type="submit" class="btn @(landing ? "btn-outline-warning" : "btn-outline-secondary")">@(landing ? "Landing On" : "Landing Off")</button>
                    </form>
                    <a asp-action="Index" asp-controller="TemplateNav" asp-route-template="@template.Name"
                       class="btn btn-outline-info">Navigation</a>
                </div>
            </div>
        </div>
    }
</div>
