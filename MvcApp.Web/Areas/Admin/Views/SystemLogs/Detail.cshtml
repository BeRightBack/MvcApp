@model MvcApp.Core.SystemLogEntry
@using System.Text.Json
@{
    ViewData["Title"] = "Log Detail";
    var pretty = Model.Properties ?? "";
    if (!string.IsNullOrWhiteSpace(Model.Properties))
    {
        try
        {
            pretty = JsonSerializer.Serialize(JsonSerializer.Deserialize<JsonElement>(Model.Properties),
                new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            pretty = Model.Properties;
        }
    }
}

<section class="py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold"><i class='bx bx-terminal'></i> Log #@Model.Id</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class='bx bx-arrow-back me-1'></i> @Localizer["Back"]</a>
        </div>

        <div class="content-card">
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">@Localizer["Level"]</dt>
                    <dd class="col-sm-9"><span class="badge bg-secondary-subtle text-secondary">@Model.Level</span></dd>

                    <dt class="col-sm-3">Logged (local)</dt>
                    <dd class="col-sm-9">@Model.TimestampExactLocal.ToString("yyyy-MM-dd HH:mm:ss.fff")</dd>

                    <dt class="col-sm-3">Logged (as written)</dt>
                    <dd class="col-sm-9"><code>@Model.Timestamp</code></dd>

                    <dt class="col-sm-3">Stored (UTC)</dt>
                    <dd class="col-sm-9"><code>@Model.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</code></dd>

                    <dt class="col-sm-3">@Localizer["Message template"]</dt>
                    <dd class="col-sm-9"><code>@Model.MessageTemplate</code></dd>

                    <dt class="col-sm-3">@Localizer["Message"]</dt>
                    <dd class="col-sm-9" style="white-space:pre-wrap;word-break:break-word;">@Model.Message</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Exception))
                    {
                        <dt class="col-sm-3 text-danger">@Localizer["Exception"]</dt>
                        <dd class="col-sm-9">
                            <pre class="mb-0 p-2 rounded" style="background:var(--template-bg-alt,#f8f9fa);white-space:pre-wrap;word-break:break-word;">@Model.Exception</pre>
                        </dd>
                    }

                    <dt class="col-sm-3">@Localizer["Properties"]</dt>
                    <dd class="col-sm-9">
                        @if (string.IsNullOrWhiteSpace(pretty))
                        {
                            <span class="text-muted">@Localizer["none"]</span>
                        }
                        else
                        {
                            <pre class="mb-0 p-2 rounded" style="background:var(--template-bg-alt,#f8f9fa);max-height:420px;overflow:auto;"><code>@pretty</code></pre>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</section>
