{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "IdentityDbConnection": "Server=localhost;Database=Identity_db;Uid=yourusername;Pwd=yourpassword;",
    "LocalisationDbConnection": "Server=localhost;Database=Localisation_db;Uid=yourusername;Pwd=yourpassword;",
    "SerilogLogs": "Server=localhost;Database=serilogsDb;Uid=yourusername;Pwd=yourpassword;"
  },
  "SmtpSettings": {
    "From": "admin@yourdomain.com",
    "Host": "mail.yourdomain.com",
    "Port": 587,
    "Username": "admin@yourdomain.com",
    "Password": "yourpassword"
  },
  "Encryption": {
    "Key": "your-very-secure-encryption-key-here-32-chars"
  },
  "Interact": {
    "Email": "payment@yourdomain.com"
  },
  "AdminEmail": "admin@yourdomain.com",
  "PayPal": {
    "PayPalMeUsername": "yourpaypalusername",
    "ClientId": "yourpaypalclientid",
    "ClientSecret": "REDACTED-SECRET"
  },
  "IpGeolocation": {
    "ApiKey": "yourapikey"
  },
  "DeepLConfig": {
    "AuthKey": "yourauthkey",
    "SourceLang": "EN",
    "TargetLangEn": "EN-US",
    "TargetLangIt": "IT",
    "TargetLangFr": "FR",
    "TargetLangEs": "ES",
    "TargetLangDe": "DE",
    "TargetLangPt": "PT-PT"
  },
  "Administrator": {
    "Role": "Admin",
    "Username": "admin",
    "User": "admin@yourdomain.com",
    "Password": "yourpassword"
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:9001"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
