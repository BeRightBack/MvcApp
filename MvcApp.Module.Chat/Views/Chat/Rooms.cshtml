@model IEnumerable<ChatRoom>
@{
    ViewData["Title"] = "Chat Rooms";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Chat Rooms</h4>
                    <a asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-outline-secondary">Private Messages</a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var room in Model)
                        {
                            <a asp-action="Room" asp-route-id="@room.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;font-size:1.2rem">
                                    #
                                </div>
                                <div>
                                    <strong>@room.Name</strong>
                                    @if (!string.IsNullOrEmpty(room.Description))
                                    {
                                        <small class="d-block text-muted">@room.Description</small>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
